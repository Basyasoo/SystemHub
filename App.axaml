<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MacStyleHub.App"
             xmlns:local="using:MacStyleHub"
             xmlns:services="using:MacStyleHub.Services"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="avares://SystemHub/Assets/app.ico" 
                      ToolTipText="SystemHub"
                      Clicked="OnTrayIconClicked">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="{Binding TrayMenuOpen, Source={x:Static services:LocalizationService.Instance}}" Click="OnMenuOpenClick"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="{Binding TrayMenuExit, Source={x:Static services:LocalizationService.Instance}}" Click="OnMenuExitClick"/>
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
  
    <Application.Styles>
        <FluentTheme />
        
        <!-- Global App Style Overrides -->
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter, Segoe UI, Sans-Serif"/>
        </Style>

        <!-- Smooth Page Transitions (similar to anime.js mount animations) -->
        <Style Selector="ContentControl > UserControl">
            <Setter Property="RenderTransform">
                <TransformGroup>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                    <TranslateTransform X="0" Y="0"/>
                </TransformGroup>
            </Setter>
            <Style.Animations>
                <Animation Duration="0:0:0.45" Easing="0.1, 0.9, 0.2, 1.0">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="RenderTransform">
                            <TransformGroup>
                                <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                <TranslateTransform X="30" Y="0"/>
                            </TransformGroup>
                        </Setter>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="RenderTransform">
                            <TransformGroup>
                                <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                <TranslateTransform X="0" Y="0"/>
                            </TransformGroup>
                        </Setter>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Professional Minimal Card (replacing rounded cartoons) -->
        <Style Selector="Border.SystemCard">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderGray}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.35" Easing="0.34, 1.56, 0.64, 1"/>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.SystemCard:not(.Static):pointerover">
            <Setter Property="RenderTransform" Value="scale(1.018)"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
        </Style>

        <!-- Sleek Monochromatic Glassmorphism Card -->
        <Style Selector="Border.GlassCard">
            <Setter Property="Background" Value="{DynamicResource GlassBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.35" Easing="0.34, 1.56, 0.64, 1"/>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.GlassCard:not(.Static):pointerover">
            <Setter Property="RenderTransform" Value="scale(1.018)"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
        </Style>

        <!-- Minimalist Fluent Flat Buttons -->
        <Style Selector="Button.SystemButton">
            <Setter Property="Background" Value="{DynamicResource SystemBtnBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemBtnText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemBtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="0.34, 1.56, 0.64, 1"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.SystemButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemBtnHoverBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemBtnBorder}"/>
            <Setter Property="RenderTransform" Value="scale(1.04)"/>
        </Style>
        <Style Selector="Button.SystemButton:pressed">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="RenderTransform" Value="scale(0.96)"/>
        </Style>

        <!-- Sleek Accent Buttons -->
        <Style Selector="Button.AccentButton">
            <Setter Property="Background" Value="#0A84FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="0.34, 1.56, 0.64, 1"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.AccentButton:pointerover">
            <Setter Property="Background" Value="#359AFF"/>
            <Setter Property="RenderTransform" Value="scale(1.04)"/>
        </Style>
        <Style Selector="Button.AccentButton:pressed">
            <Setter Property="Background" Value="#0066CC"/>
            <Setter Property="RenderTransform" Value="scale(0.96)"/>
        </Style>
        
        <!-- Flat sidebar items styling -->
        <Style Selector="ListBoxItem.SidebarItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
        
        <!-- Shimmering Skeleton Loader Styles -->
        <Style Selector="Border.Skeleton">
            <Setter Property="Background" Value="{DynamicResource SkeletonBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Height" Value="14"/>
            <Style.Animations>
                <Animation Duration="0:0:1.4" IterationCount="Infinite" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.5"/>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="1.0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.5"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Border.SkeletonCircle">
            <Setter Property="Background" Value="{DynamicResource SkeletonBrush}"/>
            <Setter Property="CornerRadius" Value="100"/>
            <Style.Animations>
                <Animation Duration="0:0:1.4" IterationCount="Infinite" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.5"/>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="1.0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.5"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Prevent clipping of scaled card borders inside list views -->
        <Style Selector="ItemsControl">
            <Setter Property="ClipToBounds" Value="False"/>
        </Style>
        <Style Selector="ItemsPresenter">
            <Setter Property="ClipToBounds" Value="False"/>
        </Style>
        <Style Selector="ItemsControl > ItemsPresenter > StackPanel">
            <Setter Property="ClipToBounds" Value="False"/>
        </Style>
        <Style Selector="ItemsControl > ItemsPresenter > VirtualizingStackPanel">
            <Setter Property="ClipToBounds" Value="False"/>
        </Style>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="AccentBlue" Color="#0A84FF"/>

            <!-- Theme Aware Brushes -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <!-- Light theme -->
                    <SolidColorBrush x:Key="SidebarBg" Color="#F2F2F7"/>
                    <SolidColorBrush x:Key="MainBg" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="TextPrimary" Color="#1C1C1E"/>
                    <SolidColorBrush x:Key="TextSecondary" Color="#6C6C70"/>
                    <SolidColorBrush x:Key="CardBg" Color="#F2F2F7"/>
                    <SolidColorBrush x:Key="BorderGray" Color="#E5E5EA"/>
                    
                    <SolidColorBrush x:Key="GlassBg" Color="#0D000000"/>
                    <SolidColorBrush x:Key="GlassBorder" Color="#1E000000"/>
                    
                    <SolidColorBrush x:Key="SystemBtnBg" Color="#E5E5EA"/>
                    <SolidColorBrush x:Key="SystemBtnBorder" Color="#D1D1D6"/>
                    <SolidColorBrush x:Key="SystemBtnText" Color="#1C1C1E"/>
                    <SolidColorBrush x:Key="SystemBtnHoverBg" Color="#D1D1D6"/>
                    
                    <SolidColorBrush x:Key="SidebarHoverBg" Color="#12000000"/>
                    <SolidColorBrush x:Key="SidebarHoverFg" Color="#1C1C1E"/>
                    
                    <LinearGradientBrush x:Key="SkeletonBrush" StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Offset="0.0" Color="#E5E5EA"/>
                        <GradientStop Offset="0.5" Color="#F2F2F7"/>
                        <GradientStop Offset="1.0" Color="#E5E5EA"/>
                    </LinearGradientBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <!-- Dark theme -->
                    <SolidColorBrush x:Key="SidebarBg" Color="#101012"/>
                    <SolidColorBrush x:Key="MainBg" Color="#161618"/>
                    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="TextSecondary" Color="#8E8E93"/>
                    <SolidColorBrush x:Key="CardBg" Color="#1C1C1E"/>
                    <SolidColorBrush x:Key="BorderGray" Color="#2C2C2E"/>
                    
                    <SolidColorBrush x:Key="GlassBg" Color="#0F18181A"/>
                    <SolidColorBrush x:Key="GlassBorder" Color="#1DFFFFFF"/>
                    
                    <SolidColorBrush x:Key="SystemBtnBg" Color="#242426"/>
                    <SolidColorBrush x:Key="SystemBtnBorder" Color="#323236"/>
                    <SolidColorBrush x:Key="SystemBtnText" Color="#E1E1E5"/>
                    <SolidColorBrush x:Key="SystemBtnHoverBg" Color="#2E2E30"/>
                    
                    <SolidColorBrush x:Key="SidebarHoverBg" Color="#15FFFFFF"/>
                    <SolidColorBrush x:Key="SidebarHoverFg" Color="#FFFFFF"/>
                    
                    <LinearGradientBrush x:Key="SkeletonBrush" StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Offset="0.0" Color="#242426"/>
                        <GradientStop Offset="0.5" Color="#2C2C2E"/>
                        <GradientStop Offset="1.0" Color="#242426"/>
                    </LinearGradientBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

