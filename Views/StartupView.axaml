<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MacStyleHub.ViewModels"
             xmlns:services="using:MacStyleHub.Services"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="550"
             x:Class="MacStyleHub.Views.StartupView"
             x:DataType="vm:StartupViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30" Spacing="25">
            <!-- Header -->
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Spacing="5">
                    <TextBlock Text="{Binding SidebarStartup, Source={x:Static services:LocalizationService.Instance}}" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" LetterSpacing="-0.5"/>
                    <TextBlock Text="{Binding StartupDesc, Source={x:Static services:LocalizationService.Instance}}" FontSize="14" Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
                
                <Button Grid.Column="1" Classes="SystemButton" Command="{Binding RefreshCommand}" Content="{Binding StartupRefresh, Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center"/>
            </Grid>

            <!-- Autostart Toggle Switch for this App -->
            <Border Classes="GlassCard" Padding="20">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StartupToggleText, Source={x:Static services:LocalizationService.Instance}}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{Binding StartupToggleSubtext, Source={x:Static services:LocalizationService.Instance}}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                    
                    <!-- Fluent ToggleSwitch (No text inside) -->
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsAppAutostartEnabled, Mode=TwoWay}"
                                  OnContent="" OffContent=""
                                  VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Other Startup Programs List -->
            <StackPanel Spacing="12">
                <TextBlock Text="{Binding StartupActiveTitle, Source={x:Static services:LocalizationService.Instance}}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,5,0,0"/>
                
                <ItemsControl ItemsSource="{Binding StartupItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                             <Border Classes="SystemCard" Margin="0,0,0,8" Padding="14" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderGray}">
                                 <Grid ColumnDefinitions="*, Auto, Auto">
                                     <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                                         <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                         <TextBlock Text="{Binding Command}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                                     </StackPanel>
                                     
                                     <!-- Location Badge -->
                                     <Border Grid.Column="1" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderGray}" BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center" Margin="15,0,0,0">
                                         <TextBlock Text="{Binding Location}" FontSize="11" Foreground="{DynamicResource AccentBlue}" FontWeight="Medium"/>
                                     </Border>

                                     <!-- Toggle Switch -->
                                     <ToggleSwitch Grid.Column="2" 
                                                   IsChecked="{Binding IsEnabled, Mode=TwoWay}" 
                                                   OnContent="" 
                                                   OffContent="" 
                                                   VerticalAlignment="Center" 
                                                   Margin="15,0,0,0"/>
                                 </Grid>
                             </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
