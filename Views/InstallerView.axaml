<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MacStyleHub.ViewModels"
             xmlns:services="using:MacStyleHub.Services"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="550"
             x:Class="MacStyleHub.Views.InstallerView"
             x:DataType="vm:InstallerViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30" Spacing="25">
            <!-- Header -->
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Spacing="5" Margin="0,0,20,0">
                    <TextBlock Text="{Binding InstallerHeader}" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" LetterSpacing="-0.5"/>
                    <TextBlock Text="{Binding InstallerDesc}" FontSize="14" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Classes="SystemButton" Command="{Binding RescanInstalledCommand}" Content="{Binding InstallerBtnScan}"/>
                    <Button Classes="AccentButton" Command="{Binding InstallSelectedCommand}" Content="{Binding InstallerBtnInstallSelected, Source={x:Static services:LocalizationService.Instance}}"/>
                </StackPanel>
            </Grid>

            <!-- Software Packages List -->
            <ItemsControl ItemsSource="{Binding Programs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="GlassCard" Margin="0,0,0,12" Padding="18" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderGray}">
                            <Grid ColumnDefinitions="Auto, Auto, *, Auto, Auto" RowDefinitions="Auto, Auto">
                                <!-- Checkbox to select -->
                                <CheckBox Grid.Column="0" Grid.RowSpan="2" IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsNotInstalled}" Margin="0,0,15,0" VerticalAlignment="Center"/>

                                <!-- Icon -->
                                <Border Grid.Column="1" Grid.RowSpan="2" Background="{DynamicResource BorderGray}" Width="40" Height="40" CornerRadius="20" Margin="0,0,15,0" VerticalAlignment="Center">
                                    <PathIcon Data="{StaticResource IconFlash}" Width="16" Height="16" Foreground="{DynamicResource AccentBlue}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Text Details -->
                                <StackPanel Grid.Column="2" Grid.Row="0" Spacing="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                        <Border Background="{DynamicResource BorderGray}" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Category}" FontSize="9" Foreground="{DynamicResource TextSecondary}" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- Progress Bar and Status -->
                                <StackPanel Grid.Column="2" Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,6,0,0" IsVisible="{Binding IsInstalling}">
                                    <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" Width="180" Height="6" Foreground="{DynamicResource AccentBlue}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Status Label -->
                                <TextBlock Grid.Column="3" Grid.RowSpan="2" Text="{Binding StateText}" FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,20,0" FontWeight="Medium"/>

                                <!-- Action Button -->
                                <Button Grid.Column="4" Grid.RowSpan="2" Classes="SystemButton" Command="{Binding $parent[UserControl].((vm:InstallerViewModel)DataContext).InstallProgramCommand}" CommandParameter="{Binding Id}" IsEnabled="{Binding IsNotInstalled}" VerticalAlignment="Center" Width="120" HorizontalContentAlignment="Center">
                                    <TextBlock Text="{Binding ActionText}"/>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
