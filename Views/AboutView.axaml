<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MacStyleHub.ViewModels"
             xmlns:services="using:MacStyleHub.Services"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="MacStyleHub.Views.AboutView"
             x:DataType="vm:AboutViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,40,30,40" Spacing="35" HorizontalAlignment="Center" MaxWidth="650">
            
            <!-- App Profile Card (Centered, Borderless) -->
            <StackPanel Spacing="20" HorizontalAlignment="Center">
                <!-- Custom Glowing App Logo (Centered) -->
                <Border Width="100" Height="100" CornerRadius="22" BorderBrush="#2FFFFFFF" BorderThickness="1" ClipToBounds="True" HorizontalAlignment="Center">
                    <Image Source="avares://SystemHub/Assets/logo.jpg" Width="100" Height="100" Stretch="UniformToFill"/>
                </Border>

                <!-- Title and Version -->
                <StackPanel Spacing="5" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding AboutTitle, Source={x:Static services:LocalizationService.Instance}}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding AppVersion, StringFormat='v{0}'}" FontSize="15" Foreground="{StaticResource AccentBlue}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Description (Centered) -->
                <TextBlock Text="{Binding AboutDesc, Source={x:Static services:LocalizationService.Instance}}" FontSize="14" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="22" TextAlignment="Center"/>

                <Separator Height="1" Background="#262628" Margin="0,10" Width="400" HorizontalAlignment="Center"/>

                <!-- Metadata Properties (Centered Grid) -->
                <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="Auto, Auto" HorizontalAlignment="Center">
                    <!-- Version -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding AboutVersion, Source={x:Static services:LocalizationService.Instance}}" FontSize="13" Foreground="{StaticResource TextSecondary}" FontWeight="Medium" Margin="0,0,20,10" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AppVersion}" FontSize="13" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" Margin="0,0,0,10" HorizontalAlignment="Left"/>

                    <!-- Developer -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding AboutDev, Source={x:Static services:LocalizationService.Instance}}" FontSize="13" Foreground="{StaticResource TextSecondary}" FontWeight="Medium" Margin="0,0,20,10" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Developer Basyasoo" FontSize="13" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" Margin="0,0,0,10" HorizontalAlignment="Left"/>

                    <!-- License -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding AboutLicense, Source={x:Static services:LocalizationService.Instance}}" FontSize="13" Foreground="{StaticResource TextSecondary}" FontWeight="Medium" Margin="0,0,20,0" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AboutLicenseType, Source={x:Static services:LocalizationService.Instance}}" FontSize="13" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                </Grid>

                <!-- Check Updates Section -->
                <StackPanel Spacing="10" HorizontalAlignment="Center" Margin="0,15,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" IsVisible="{Binding !IsDownloading}">
                        <Button Classes="SystemButton" Content="{Binding AboutCheckUpdates, Source={x:Static services:LocalizationService.Instance}}" Command="{Binding CheckForUpdatesCommand}"/>
                        <Button Classes="AccentButton" Content="{Binding AboutDownload, Source={x:Static services:LocalizationService.Instance}}" Command="{Binding DownloadUpdateCommand}" IsVisible="{Binding UpdateAvailable}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding UpdateStatus}" FontSize="12" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" IsVisible="{Binding !IsDownloading}"/>
                    
                    <!-- In-App Download Progress -->
                    <StackPanel Spacing="8" Width="300" IsVisible="{Binding IsDownloading}">
                        <TextBlock Text="{Binding DownloadStatus}" FontSize="12" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                        <ProgressBar Value="{Binding DownloadProgress}" Minimum="0" Maximum="100" Height="6" CornerRadius="3" Background="{DynamicResource BorderGray}" Foreground="{StaticResource AccentBlue}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <Separator Height="1" Background="#262628" Margin="0,10" Width="450" HorizontalAlignment="Center"/>

            <!-- Features Block (Centered, Borderless) -->
            <StackPanel Spacing="15" HorizontalAlignment="Center" Width="600">
                <TextBlock Text="{Binding AboutFeaturesTitle, Source={x:Static services:LocalizationService.Instance}}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                
                <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*, *" HorizontalAlignment="Center">
                    <!-- Feature 1: Weather -->
                    <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="Auto, *" Margin="0,0,20,20" Width="260" HorizontalAlignment="Left">
                        <PathIcon Grid.Column="0" Data="{StaticResource IconMoon}" Width="20" Height="20" Foreground="{StaticResource AccentBlue}" Margin="0,0,12,0" VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{Binding AboutFeatureWeatherTitle, Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="{Binding AboutFeatureWeatherDesc, Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Feature 2: System Specs -->
                    <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="Auto, *" Margin="20,0,0,20" Width="260" HorizontalAlignment="Left">
                        <PathIcon Grid.Column="0" Data="{StaticResource IconSystem}" Width="20" Height="20" Foreground="{StaticResource AccentBlue}" Margin="0,0,12,0" VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{Binding AboutFeatureSystemTitle, Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="{Binding AboutFeatureSystemDesc, Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Feature 3: Cleaner -->
                    <Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="Auto, *" Margin="0,0,20,20" Width="260" HorizontalAlignment="Left">
                        <PathIcon Grid.Column="0" Data="{StaticResource IconTrash}" Width="20" Height="20" Foreground="{StaticResource AccentBlue}" Margin="0,0,12,0" VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{Binding AboutFeatureCleanerTitle, Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="{Binding AboutFeatureCleanerDesc, Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Feature 4: Startup -->
                    <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="Auto, *" Margin="20,0,0,20" Width="260" HorizontalAlignment="Left">
                        <PathIcon Grid.Column="0" Data="{StaticResource IconSettings}" Width="20" Height="20" Foreground="{StaticResource AccentBlue}" Margin="0,0,12,0" VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{Binding AboutFeatureStartupTitle, Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="{Binding AboutFeatureStartupDesc, Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Feature 5: Media Hub -->
                    <Grid Grid.Row="2" Grid.Column="0" ColumnDefinitions="Auto, *" Margin="0,0,20,0" Width="260" HorizontalAlignment="Left">
                        <PathIcon Grid.Column="0" Data="{StaticResource IconMusic}" Width="20" Height="20" Foreground="{StaticResource AccentBlue}" Margin="0,0,12,0" VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{Binding AboutFeaturePlayerTitle, Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="{Binding AboutFeaturePlayerDesc, Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Feature 6: App Installer -->
                    <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="Auto, *" Margin="20,0,0,0" Width="260" HorizontalAlignment="Left">
                        <PathIcon Grid.Column="0" Data="{StaticResource IconFlash}" Width="20" Height="20" Foreground="{StaticResource AccentBlue}" Margin="0,0,12,0" VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{Binding AboutFeatureInstallerTitle, Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="{Binding AboutFeatureInstallerDesc, Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </StackPanel>


        </StackPanel>
    </ScrollViewer>
</UserControl>
