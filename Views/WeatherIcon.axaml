<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:MacStyleHub.Views"
             x:Class="MacStyleHub.Views.WeatherIcon"
             Name="self">
    <UserControl.Styles>
        <!-- Default: all paths hidden -->
        <Style Selector="Path">
            <Setter Property="IsVisible" Value="False"/>
        </Style>

        <!-- Sun icon -->
        <Style Selector="views|WeatherIcon[Icon=sun] Path#SunPath">
            <Setter Property="IsVisible" Value="True"/>
        </Style>

        <!-- Moon icon -->
        <Style Selector="views|WeatherIcon[Icon=moon] Path#MoonPath">
            <Setter Property="IsVisible" Value="True"/>
        </Style>

        <!-- Cloud icon -->
        <Style Selector="views|WeatherIcon[Icon=cloud] Path#CloudPath">
            <Setter Property="IsVisible" Value="True"/>
        </Style>

        <!-- CloudSun icon -->
        <Style Selector="views|WeatherIcon[Icon=cloud-sun] Path#SunPartialPath">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="views|WeatherIcon[Icon=cloud-sun] Path#CloudPathForSun">
            <Setter Property="IsVisible" Value="True"/>
        </Style>

        <!-- CloudMoon icon -->
        <Style Selector="views|WeatherIcon[Icon=cloud-moon] Path#MoonPartialPath">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="views|WeatherIcon[Icon=cloud-moon] Path#CloudPathForMoon">
            <Setter Property="IsVisible" Value="True"/>
        </Style>

        <!-- Rain icon -->
        <Style Selector="views|WeatherIcon[Icon=rain] Path#CloudPathForRain">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="views|WeatherIcon[Icon=rain] Path#RainPath">
            <Setter Property="IsVisible" Value="True"/>
        </Style>

        <!-- Snow icon -->
        <Style Selector="views|WeatherIcon[Icon=snow] Path#CloudPathForRain">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="views|WeatherIcon[Icon=snow] Path#SnowPath">
            <Setter Property="IsVisible" Value="True"/>
        </Style>

        <!-- Thunderstorm icon -->
        <Style Selector="views|WeatherIcon[Icon=thunderstorm] Path#CloudPathForLightning">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="views|WeatherIcon[Icon=thunderstorm] Path#LightningPath">
            <Setter Property="IsVisible" Value="True"/>
        </Style>

        <!-- Fog icon -->
        <Style Selector="views|WeatherIcon[Icon=fog] Path#CloudPathForFog">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="views|WeatherIcon[Icon=fog] Path#FogPath">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
    </UserControl.Styles>

    <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
        <!-- 256x256 absolute coordinate canvas for all Phosphor weather icons -->
        <Canvas Width="256" Height="256">
            <!-- Sun path -->
            <Path Name="SunPath" Fill="#FFB800" 
                  Data="M120,40V16a8,8,0,0,1,16,0V40a8,8,0,0,1-16,0Zm72,88a64,64,0,1,1-64-64A64.07,64.07,0,0,1,192,128Zm-16,0a48,48,0,1,0-48,48A48.05,48.05,0,0,0,176,128ZM58.34,69.66A8,8,0,0,0,69.66,58.34l-16-16A8,8,0,0,0,42.34,53.66Zm0,116.68-16,16a8,8,0,0,0,11.32,11.32l16-16a8,8,0,0,0-11.32-11.32ZM192,72a8,8,0,0,0,5.66-2.34l16-16a8,8,0,0,0-11.32-11.32l-16,16A8,8,0,0,0,192,72Zm5.66,114.34a8,8,0,0,0-11.32,11.32l16,16a8,8,0,0,0,11.32-11.32ZM48,128a8,8,0,0,0-8-8H16a8,8,0,0,0,0,16H40A8,8,0,0,0,48,128Zm80,80a8,8,0,0,0-8,8v24a8,8,0,0,0,16,0V216A8,8,0,0,0,128,208Zm112-88H216a8,8,0,0,0,0,16h24a8,8,0,0,0,0-16Z"/>

            <!-- Sun partial path (for cloud-sun) -->
            <Path Name="SunPartialPath" Fill="#FFB800" 
                  Data="M164,72a76.2,76.2,0,0,0-20.26,2.73,55.63,55.63,0,0,0-9.41-11.54l9.51-13.57a8,8,0,1,0-13.11-9.18L121.22,54A55.9,55.9,0,0,0,96,48c-.58,0-1.16,0-1.74,0L91.37,31.71a8,8,0,1,0-15.75,2.77L78.5,50.82A56.1,56.1,0,0,0,55.23,65.67L41.61,56.14a8,8,0,1,0-9.17,13.11L46,78.77A55.55,55.55,0,0,0,40,104c0,.57,0,1.15,0,1.72L23.71,108.6a8,8,0,0,0,1.38,15.88,8.24,8.24,0,0,0,1.39-.12l16.32-2.88a55.74,55.74,0,0,0,5.86,12.42A52,52,0,0,0,84,224h80a76,76,0,0,0,0-152ZM56,104a40,40,0,0,1,72.54-23.24,76.26,76.26,0,0,0-35.62,40,52.14,52.14,0,0,0-31,4.17A40,40,0,0,1,56,104Z"/>

            <!-- Moon path -->
            <Path Name="MoonPath" Fill="#70D7FF" 
                  Data="M233.54,142.23a8,8,0,0,0-8-2,88.08,88.08,0,0,1-109.8-109.8,8,8,0,0,0-10-10,104.84,104.84,0,0,0-52.91,37A104,104,0,0,0,136,224a103.09,103.09,0,0,0,62.52-20.88,104.84,104.84,0,0,0,37-52.91A8,8,0,0,0,233.54,142.23ZM188.9,190.34A88,88,0,0,1,65.66,67.11a89,89,0,0,1,31.4-26A106,106,0,0,0,96,56,104.11,104.11,0,0,0,200,160a106,106,0,0,0,14.92-1.06A89,89,0,0,1,188.9,190.34Z"/>

            <!-- Moon partial path (for cloud-moon) -->
            <Path Name="MoonPartialPath" Fill="#70D7FF" 
                  Data="M172,72a76.45,76.45,0,0,0-12.36,1A71.93,71.93,0,0,0,104.17,9.83a8,8,0,0,0-9.59,9.58A56.05,56.05,0,0,1,40,88a56.45,56.45,0,0,1-12.59-1.42,8,8,0,0,0-9.59,9.59,72.22,72.22,0,0,0,32.29,45.06A52,52,0,0,0,92,224h80a76,76,0,0,0,0-152ZM37.37,104c.87,0,1.75,0,2.63,0a72.08,72.08,0,0,0,72-72c0-.89,0-1.78,0-2.67a55.63,55.63,0,0,1,32,48,76.28,76.28,0,0,0-43,43.4A52,52,0,0,0,62,129.59,56.22,56.22,0,0,1,37.37,104Z"/>

            <!-- Cloud path (standard size & position) -->
            <Path Name="CloudPath" Fill="#E5E5EA" 
                  Data="M160,40A88.09,88.09,0,0,0,81.29,88.67,64,64,0,1,0,72,216h88a88,88,0,0,0,0-176Zm0,160H72a48,48,0,0,1,0-96c1.1,0,2.2,0,3.29.11A88,88,0,0,0,72,128a8,8,0,0,0,16,0,72,72,0,1,1,72,72Z"/>

            <!-- Cloud path for sun (used in cloud-sun combined icon) -->
            <Path Name="CloudPathForSun" Fill="#E5E5EA" 
                  Data="M164,208H84a36,36,0,1,1,4.78-71.69c-.37,2.37-.63,4.79-.77,7.23a8,8,0,0,0,16,.92,58.91,58.91,0,0,1,1.88-11.81c0-.16.09-.32.12-.48A60.06,60.06,0,1,1,164,208Z"/>

            <!-- Cloud path for moon (used in cloud-moon combined icon) -->
            <Path Name="CloudPathForMoon" Fill="#E5E5EA" 
                  Data="M172,208H92a36,36,0,1,1,4.78-71.69c-.37,2.37-.63,4.79-.77,7.23a8,8,0,0,0,16,.92,58.91,58.91,0,0,1,1.88-11.81c0-.16.09-.32.12-.48A60.06,60.06,0,1,1,172,208Z"/>

            <!-- Cloud path for rain & snow (used in cloud-rain/cloud-snow) -->
            <Path Name="CloudPathForRain" Fill="#E5E5EA" 
                  Data="M232,92a76.08,76.08,0,0,1-76,76H76A52,52,0,0,1,76,64a53.26,53.26,0,0,1,8.92.76A76.08,76.08,0,0,1,232,92Zm-16,0A60.06,60.06,0,0,0,96,88.46a8,8,0,0,1-16-.92q.21-3.66.77-7.23A38.11,38.11,0,0,0,76,80a36,36,0,0,0,0,72h80A60.07,60.07,0,0,0,216,92Z"/>

            <!-- Cloud path for lightning (used in cloud-lightning) -->
            <Path Name="CloudPathForLightning" Fill="#E5E5EA" 
                  Data="M156,16A76.2,76.2,0,0,0,84.92,64.76,53.26,53.26,0,0,0,76,64a52,52,0,0,0,0,104h80a76,76,0,0,0,0-152Zm0,136H76a36,36,0,0,1,0-72,38.11,38.11,0,0,1,4.78.31q-.56,3.57-.77,7.23a8,8,0,0,0,16,.92A60.06,60.06,0,1,1,156,152Z"/>

            <!-- Cloud path for fog (used in cloud-fog) -->
            <Path Name="CloudPathForFog" Fill="#E5E5EA" 
                  Data="M232,100a76.08,76.08,0,0,1-76,76H76A52,52,0,0,1,76,72a53.26,53.26,0,0,1,8.92.76A76.08,76.08,0,0,1,232,100Zm-16,0A60.06,60.06,0,0,0,96,96.46a8,8,0,0,1-16-.92q.21-3.66.77-7.23A38.11,38.11,0,0,0,76,88a36,36,0,0,0,0,72h80A60.07,60.07,0,0,0,216,100Z"/>

            <!-- Rain drops path -->
            <Path Name="RainPath" Fill="#0A84FF" 
                  Data="M158.66,196.44l-32,48a8,8,0,1,1-13.32-8.88l32-48a8,8,0,0,1,13.32,8.88ZM132.28,168l-29.62,44.44a8,8,0,1,1-13.32-8.88l29.62-44.44a8,8,0,0,1,13.32,8.88Z"/>

            <!-- Snow flakes path -->
            <Path Name="SnowPath" Fill="#64D2FF" 
                  Data="M88,196a12,12,0,1,1-12-12A12,12,0,0,1,88,196Zm28,4a12,12,0,1,0,12,12A12,12,0,0,0,116,200Zm48-16a12,12,0,1,0,12,12A12,12,0,0,0,164,184ZM68,224a12,12,0,1,0,12,12A12,12,0,0,0,68,224Zm88,0a12,12,0,1,0,12,12A12,12,0,0,0,156,224Z"/>

            <!-- Lightning path (custom closed clean vector shape) -->
            <Path Name="LightningPath" Fill="#FFCC00" 
                  Data="M113.87,168L97.14,195.88A8,8,0,0,0,104,208h25.87l-16.73,27.88a8,8,0,0,0,13.72,8.24l24-40A8,8,0,0,0,144,192H118.13l14.4-24Z"/>

            <!-- Fog lines path -->
            <Path Name="FogPath" Fill="#AEAEB2" 
                  Data="M120,208H72a8,8,0,0,1,0-16h48a8,8,0,0,1,0,16Zm64-16H160a8,8,0,0,0,0,16h24a8,8,0,0,0,0-16Zm-24,32H104a8,8,0,0,0,0,16h56a8,8,0,0,0,0-16Z"/>
        </Canvas>
    </Viewbox>
</UserControl>
