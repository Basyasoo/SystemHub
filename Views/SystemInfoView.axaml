<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SystemHub.ViewModels"
             xmlns:services="using:SystemHub.Services"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="SystemHub.Views.SystemInfoView"
             x:DataType="vm:SystemInfoViewModel">

    <UserControl.Styles>
        <Style Selector="ToggleButton.ExpandCaret">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
        </Style>
        <Style Selector="ToggleButton.ExpandCaret PathIcon">
            <Setter Property="RenderTransform" Value="rotate(0deg)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.ExpandCaret:checked PathIcon">
            <Setter Property="RenderTransform" Value="rotate(90deg)"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30" Spacing="25">
            <!-- Header -->
            <StackPanel Spacing="5">
                <TextBlock Text="{Binding SystemViewHeader, Source={x:Static services:LocalizationService.Instance}}" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" LetterSpacing="-0.5"/>
                <TextBlock Text="{Binding SystemViewSubheader, Source={x:Static services:LocalizationService.Instance}}" FontSize="14" Foreground="{DynamicResource TextSecondary}"/>
            </StackPanel>

            <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto, Auto" HorizontalAlignment="Stretch">
                
                <!-- OS Info Card -->
                <Border Grid.Column="0" Grid.Row="0" Classes="SystemCard" Margin="0,0,10,15" VerticalAlignment="Stretch" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderGray}">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconSystem}" Width="16" Height="16" Foreground="{DynamicResource AccentBlue}"/>
                            <TextBlock Text="{Binding SystemOsTitle, Source={x:Static services:LocalizationService.Instance}}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>
                        <Separator Background="{DynamicResource BorderGray}" Margin="0,2"/>
                        
                        <Grid ColumnDefinitions="Auto, *">
                            <PathIcon Grid.Column="0" Data="{StaticResource IconSystem}" Width="40" Height="40" Foreground="{DynamicResource TextSecondary}" Margin="0,0,18,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="{Binding OsName}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{Binding SystemVersionLabel, Source={x:Static services:LocalizationService.Instance}}" FontSize="13" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Text=" " FontSize="13" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Text="{Binding OsVersion}" FontSize="13" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{Binding SystemBuildLabel, Source={x:Static services:LocalizationService.Instance}}" FontSize="13" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Text=" " FontSize="13" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Text="{Binding OsBuild}" FontSize="13" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{Binding SystemArchLabel, Source={x:Static services:LocalizationService.Instance}}" FontSize="13" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Text=" " FontSize="13" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Text="{Binding OsArchitecture}" FontSize="13" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        
                        <Separator Background="{DynamicResource BorderGray}" Margin="0,2"/>
                        <Grid ColumnDefinitions="Auto, *" Margin="0,0,0,0">
                            <TextBlock Grid.Column="0" Text="HWID: " FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                            <SelectableTextBlock Grid.Column="1" Text="{Binding Hwid}" FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Hardware Specifications Card -->
                <Border Grid.Column="1" Grid.Row="0" Classes="SystemCard" Margin="10,0,0,15" VerticalAlignment="Stretch" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderGray}">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconCpu}" Width="16" Height="16" Foreground="{DynamicResource AccentBlue}"/>
                            <TextBlock Text="{Binding SystemHardwareTitle, Source={x:Static services:LocalizationService.Instance}}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>
                        <Separator Background="{DynamicResource BorderGray}" Margin="0,2"/>
                        
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="130, *">
                                <TextBlock Grid.Column="0" Text="{Binding SystemMotherboardLabel, Source={x:Static services:LocalizationService.Instance}}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,10,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding MotherboardLocalized}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="130, *">
                                <TextBlock Grid.Column="0" Text="{Binding SystemCpuLabel, Source={x:Static services:LocalizationService.Instance}}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,10,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding CpuName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="130, *">
                                <TextBlock Grid.Column="0" Text="{Binding SystemFrequencyLabel, Source={x:Static services:LocalizationService.Instance}}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,10,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" TextWrapping="Wrap">
                                    <TextBlock.Inlines>
                                        <Run Text="{Binding CpuMaxSpeed, StringFormat={}{0:F2} GHz}"/>
                                        <Run Text=" (" Foreground="{DynamicResource TextSecondary}"/>
                                        <Run Text="{Binding SystemCoresLabel, Source={x:Static services:LocalizationService.Instance}}" Foreground="{DynamicResource TextSecondary}"/>
                                        <Run Text=":" Foreground="{DynamicResource TextSecondary}"/>
                                        <Run Text="{Binding Cores}" Foreground="{DynamicResource TextSecondary}"/>
                                        <Run Text=", " Foreground="{DynamicResource TextSecondary}"/>
                                        <Run Text="{Binding SystemThreadsLabel, Source={x:Static services:LocalizationService.Instance}}" Foreground="{DynamicResource TextSecondary}"/>
                                        <Run Text=":" Foreground="{DynamicResource TextSecondary}"/>
                                        <Run Text="{Binding LogicalProcessors}" Foreground="{DynamicResource TextSecondary}"/>
                                        <Run Text=")" Foreground="{DynamicResource TextSecondary}"/>
                                    </TextBlock.Inlines>
                                </TextBlock>
                            </Grid>
                            <Grid ColumnDefinitions="130, *">
                                <TextBlock Grid.Column="0" Text="{Binding SystemGpuLabel, Source={x:Static services:LocalizationService.Instance}}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,10,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding GpuListTextLocalized}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- CPU & RAM Realtime monitor -->
                <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Classes="GlassCard" Margin="0,5,0,15">
                    <StackPanel Spacing="15">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconSettings}" Width="16" Height="16" Foreground="{DynamicResource AccentBlue}"/>
                            <TextBlock Text="{Binding SystemRealtimePerf, Source={x:Static services:LocalizationService.Instance}}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>
                        
                        <Grid ColumnDefinitions="*, *, *">
                            <!-- CPU Usage -->
                            <StackPanel Grid.Column="0" Margin="0,0,15,0" Spacing="6">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding SystemCpuLoad, Source={x:Static services:LocalizationService.Instance}}" FontSize="13" Foreground="{DynamicResource TextPrimary}" FontWeight="Medium"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CpuUsage, StringFormat={}{0}%}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                </Grid>
                                <ProgressBar Value="{Binding CpuUsage}" Minimum="0" Maximum="100" Height="8" CornerRadius="4" Background="{DynamicResource BorderGray}" Foreground="{DynamicResource AccentBlue}"/>
                                
                                <!-- CPU Temp History Sparkline -->
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding SysInfoTempHistory, Source={x:Static services:LocalizationService.Instance}}" FontSize="9" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                    <Border BorderBrush="{DynamicResource BorderGray}" BorderThickness="1" CornerRadius="4" Padding="2" Background="#0AFFFFFF" VerticalAlignment="Center">
                                        <Canvas Width="150" Height="30">
                                            <Polyline Points="{Binding CpuTempPoints}" Stroke="#FF9500" StrokeThickness="1.5"/>
                                        </Canvas>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- RAM Usage -->
                            <StackPanel Grid.Column="1" Margin="15,0,15,0" Spacing="6">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding SystemRamLabel, Source={x:Static services:LocalizationService.Instance}}" FontSize="13" Foreground="{DynamicResource TextPrimary}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding RamUsed, StringFormat={}{0:F1} GB}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                </Grid>
                                <ProgressBar Value="{Binding RamUsagePercent}" Minimum="0" Maximum="100" Height="8" CornerRadius="4" Background="{DynamicResource BorderGray}" Foreground="#34C759"/>
                                <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding SysInfoTotal, Source={x:Static services:LocalizationService.Instance}}" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Text="{Binding TotalRam, StringFormat={}{0:F1} GB}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="{Binding RamSpeed, StringFormat={}({0} MHz)}" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Network Speed -->
                            <StackPanel Grid.Column="2" Margin="15,0,0,0" Spacing="6">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding SysInfoNetworkSpeed, Source={x:Static services:LocalizationService.Instance}}" FontSize="13" Foreground="{DynamicResource TextPrimary}" FontWeight="Medium"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DownloadSpeedText}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBlue}"/>
                                </Grid>
                                
                                <Grid ColumnDefinitions="*, *" Margin="0,6,0,0">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{Binding SysInfoDownload, Source={x:Static services:LocalizationService.Instance}}" FontSize="9" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBlock Text="{Binding DownloadSpeedText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBlue}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding SysInfoUpload, Source={x:Static services:LocalizationService.Instance}}" FontSize="9" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding UploadSpeedText}" FontSize="12" FontWeight="SemiBold" Foreground="#34C759" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <Separator Background="{DynamicResource BorderGray}" Margin="0,5"/>

                        <!-- Temperatures monitor row -->
                        <Grid ColumnDefinitions="*, *, *, *">
                            <!-- CPU Temp -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <PathIcon Data="{StaticResource WeatherSun}" Width="14" Height="14" Foreground="#FF9500"/>
                                <TextBlock Text="{Binding HardwareCpuTemp, Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="{DynamicResource TextSecondary}" FontWeight="Medium" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CpuTemperature, StringFormat={}{0}°C}" FontSize="12" FontWeight="Bold" Foreground="#FF9500" VerticalAlignment="Center"/>
                            </StackPanel>
                            <!-- GPU Temp -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <PathIcon Data="{StaticResource WeatherSun}" Width="14" Height="14" Foreground="#FF5B56"/>
                                <TextBlock Text="{Binding HardwareGpuTemp, Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="{DynamicResource TextSecondary}" FontWeight="Medium" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding GpuTemperature, StringFormat={}{0}°C}" FontSize="12" FontWeight="Bold" Foreground="#FF5B56" VerticalAlignment="Center"/>
                            </StackPanel>
 
                            <!-- Motherboard Temp -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <PathIcon Data="{StaticResource WeatherSun}" Width="14" Height="14" Foreground="#FFCC00"/>
                                <TextBlock Text="{Binding SysInfoMotherboardShort, Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="{DynamicResource TextSecondary}" FontWeight="Medium" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding MotherboardTemperature, StringFormat={}{0}°C}" FontSize="12" FontWeight="Bold" Foreground="#FFCC00" VerticalAlignment="Center"/>
                            </StackPanel>
  
                            <!-- Fan Speed -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <PathIcon Data="{StaticResource IconSettings}" Width="14" Height="14" Foreground="#34C759"/>
                                <TextBlock Text="{Binding SysInfoFan, Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="{DynamicResource TextSecondary}" FontWeight="Medium" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CpuFanSpeed, StringFormat={}{0} RPM}" FontSize="12" FontWeight="Bold" Foreground="#34C759" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <!-- Top processes & Disk benchmark row -->
                <!-- Top Processes Card -->
                <Border Grid.Column="0" Grid.Row="2" Classes="GlassCard" Margin="0,5,10,15">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconCpu}" Width="16" Height="16" Foreground="{DynamicResource AccentBlue}"/>
                            <TextBlock Text="{Binding SysInfoTopProcesses, Source={x:Static services:LocalizationService.Instance}}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>
                        <Separator Background="{DynamicResource BorderGray}" Margin="0,-5"/>
                        <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,2">
                            <TextBlock Grid.Column="0" Text="{Binding SysInfoProcessCol, Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="{DynamicResource TextSecondary}" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Text="{Binding SysInfoCpuCol, Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="{DynamicResource TextSecondary}" FontWeight="Bold" Width="50" TextAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="{Binding SysInfoRamCol, Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="{DynamicResource TextSecondary}" FontWeight="Bold" Width="70" TextAlignment="Right"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding TopProcesses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,4">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding CpuPercent, StringFormat={}{0}%}" FontSize="12" Foreground="#FF9500" Width="50" TextAlignment="Right"/>
                                        <TextBlock Grid.Column="2" Text="{Binding RamMB, StringFormat={}{0} MB}" FontSize="12" Foreground="{DynamicResource TextPrimary}" Width="70" TextAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Disk Speed Test Card -->
                <Border Grid.Column="1" Grid.Row="2" Classes="GlassCard" Margin="10,5,0,15">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconFolder}" Width="16" Height="16" Foreground="{DynamicResource AccentBlue}"/>
                            <TextBlock Text="{Binding SysInfoDiskBenchmark, Source={x:Static services:LocalizationService.Instance}}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>
                        <Separator Background="{DynamicResource BorderGray}" Margin="0,-5"/>
                        <TextBlock Text="{Binding SysInfoBenchmarkDesc, Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                        
                        <Grid ColumnDefinitions="*, *" Margin="0,5">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="{Binding SysInfoSeqWrite, Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Text="{Binding BenchmarkWriteSpeed}" FontSize="18" FontWeight="Bold" Foreground="#34C759"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="{Binding SysInfoSeqRead, Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Text="{Binding BenchmarkReadSpeed}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentBlue}"/>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*, Auto" IsVisible="{Binding IsBenchmarking}">
                            <TextBlock Grid.Column="0" Text="{Binding BenchmarkStatus}" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                            <ProgressBar Grid.Column="1" IsIndeterminate="True" Height="4" Width="100" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{Binding BenchmarkStatus}" FontSize="11" Foreground="{DynamicResource TextSecondary}" IsVisible="{Binding !IsBenchmarking}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Storage Drives List -->
            <StackPanel Spacing="12">
                <TextBlock Text="{Binding SystemDrivesTitle, Source={x:Static services:LocalizationService.Instance}}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,5,0,0"/>
                
                <ItemsControl ItemsSource="{Binding Drives}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="SystemCard" Margin="0,0,0,10" Padding="15" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderGray}">
                                <StackPanel Spacing="10">
                                    <!-- Drive Header row -->
                                    <Grid ColumnDefinitions="Auto, Auto, *, Auto, Auto" VerticalAlignment="Center">
                                        <!-- Expand toggle Caret -->
                                        <ToggleButton Grid.Column="0" Classes="ExpandCaret" IsChecked="{Binding IsExpanded, Mode=TwoWay}" Margin="0,0,10,0">
                                            <PathIcon Data="{StaticResource IconChevron}" Width="10" Height="10" Foreground="{DynamicResource TextSecondary}"/>
                                        </ToggleButton>

                                        <!-- Disk Icon -->
                                        <PathIcon Grid.Column="1" Data="{StaticResource IconFolder}" Width="24" Height="24" Foreground="{DynamicResource TextSecondary}" Margin="0,0,18,0" VerticalAlignment="Center"/>
                                        
                                        <!-- Disk Details & Progress -->
                                        <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Label}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                                <TextBlock Text="{Binding Name, StringFormat=({0})}" FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Bottom"/>
                                            </StackPanel>
                                            <ProgressBar Value="{Binding UsedPercent}" Minimum="0" Maximum="100" Height="6" CornerRadius="3" Background="{DynamicResource BorderGray}" Foreground="{DynamicResource AccentBlue}"/>
                                            
                                            <!-- SMART Health details -->
                                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,2,0,0">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="{Binding HardwareSmartHealth, Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                                    <TextBlock Text="{Binding SmartHealthPercent, StringFormat={}{0}%}" FontSize="11" FontWeight="Bold" Foreground="#34C759"/>
                                                </StackPanel>
                                                <TextBlock Text="•" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                                <TextBlock Text="{Binding SmartHealthStatus}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Disk Benchmark Button -->
                                        <Button Grid.Column="3" Command="{Binding $parent[ItemsControl].((vm:SystemInfoViewModel)DataContext).RunDiskBenchmarkCommand}" CommandParameter="{Binding}" Content="{Binding SysInfoBenchmarkBtn, Source={x:Static services:LocalizationService.Instance}}" Classes="SystemButton" Height="24" Width="60" Padding="0" FontSize="11" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Center" Margin="0,0,12,0" IsEnabled="{Binding !$parent[ItemsControl].((vm:SystemInfoViewModel)DataContext).IsBenchmarking}"/>

                                        <!-- Disk Capacity Text -->
                                        <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="4">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                                                <TextBlock Text="{Binding FormattedFree}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                                <TextBlock Text="{Binding SystemFreeLabel, Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Bottom"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                                                <TextBlock Text="{Binding SystemTotalLabel, Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                                <TextBlock Text="{Binding FormattedTotal}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Expandable Folders Grid -->
                                    <Border Background="#0FFFFFFF" CornerRadius="8" Padding="15" IsVisible="{Binding IsExpanded}" Margin="34,5,0,0" BorderBrush="{DynamicResource BorderGray}" BorderThickness="1">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="{Binding SystemDiskRootFolders, Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                                            
                                            <ItemsControl ItemsSource="{Binding SubFolders}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="0,5,15,5" Width="180">
                                                            <PathIcon Data="{StaticResource IconFolder}" Width="16" Height="16" Foreground="{DynamicResource AccentBlue}" Margin="0,0,8,0"/>
                                                            <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Empty state -->
                                            <TextBlock Text="{Binding SystemDiskEmptyOrRestricted, Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="{DynamicResource TextSecondary}" IsVisible="{Binding !SubFolders.Count}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>

