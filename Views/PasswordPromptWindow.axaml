<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:services="using:SystemHub.Services"
        mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="260"
        x:Class="SystemHub.Views.PasswordPromptWindow"
        Width="380" Height="260"
        Title="{Binding AppLockTitle, Source={x:Static services:LocalizationService.Instance}}"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        CanResize="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        PointerPressed="OnPointerPressed">

    <Window.Styles>
        <Style Selector="Border.GlassCard">
            <Setter Property="Background" Value="#E61C1C1E"/>
            <Setter Property="BorderBrush" Value="#26FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="BoxShadow" Value="0 8 32 0 #50000000"/>
        </Style>
    </Window.Styles>

    <Border Classes="GlassCard">
        <Grid RowDefinitions="Auto, *, Auto">
            
            <!-- Header with Title & Icon -->
            <StackPanel Grid.Row="0" Spacing="6" HorizontalAlignment="Center">
                <PathIcon Data="M18,8 h-1 V6 c0,-2.76,-2.24,-5,-5,-5 S7,3.24,7,6 v2 H6 c-1.1,0,-2,0.9,-2,2 v10 c0,1.1,0.9,2,2,2 h12 c1.1,0,2,-0.9,2,-2 V10 C20,8.9,19.1,8,18,8 z M9,6 c0,-1.66,1.34,-3,3,-3 s3,1.34,3,3 v2 H9 V6 z M12,17 c-1.1,0,-2,-0.9,-2,-2 s0.9,-2,2,-2 s2,0.9,2,2 S13.1,17,12,17 z" 
                          Width="24" Height="24" Foreground="#FF9500" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Name="TitleText" Text="{Binding AppLockAccessDenied, Source={x:Static services:LocalizationService.Instance}}" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Name="SubtextText" Text="Password prompt" FontSize="11" Foreground="#8A8A8F" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
 
            <!-- Password Input -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="8">
                <TextBox Name="PasswordBox" PlaceholderText="{Binding AppLockEnterPassword, Source={x:Static services:LocalizationService.Instance}}" PasswordChar="•" 
                         Height="34" CornerRadius="8" FontSize="13" VerticalContentAlignment="Center" HorizontalAlignment="Stretch"
                         KeyDown="OnPasswordKeyDown"/>
                
                <TextBlock Name="ErrorText" Text="{Binding AppLockInvalidPassword, Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="#FF453A" FontWeight="Medium" 
                           HorizontalAlignment="Center" IsVisible="False"/>
            </StackPanel>
 
            <!-- Buttons -->
            <Grid Grid.Row="2" ColumnDefinitions="*, *">
                <Button Grid.Column="0" Click="OnCancelClick" Background="#26FF453A" BorderBrush="#FF453A" BorderThickness="1" 
                        Foreground="#FF453A" Height="32" CornerRadius="8" HorizontalAlignment="Stretch" Margin="0,0,6,0">
                    <TextBlock Text="{Binding AppLockClose, Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button Grid.Column="1" Click="OnUnlockClick" Background="#007AFF" Foreground="White" Height="32" CornerRadius="8" 
                        HorizontalAlignment="Stretch" Margin="6,0,0,0">
                    <TextBlock Text="{Binding AppLockUnlock, Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>

        </Grid>
    </Border>
</Window>

