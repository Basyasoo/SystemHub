<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:SystemHub.Views"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="520"
        x:Class="SystemHub.Views.AvatarCropWindow"
        x:DataType="views:AvatarCropWindow"
        Width="400" Height="520"
        Title="Редактирование аватара"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        CanResize="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        PointerPressed="OnWindowPointerPressed">

    <Window.Styles>
        <Style Selector="Border.GlassCard">
            <Setter Property="Background" Value="#E61C1C1E"/>
            <Setter Property="BorderBrush" Value="#26FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="BoxShadow" Value="0 8 32 0 #60000000"/>
        </Style>
        <Style Selector="Button.RoundControl">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="CornerRadius" Value="19"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </Window.Styles>

    <Border Classes="GlassCard">
        <Grid RowDefinitions="Auto, *, Auto, Auto, Auto">
            
            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,15">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Редактирование аватара" FontSize="16" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Перетаскивайте изображение и настройте обрезку" FontSize="11" Foreground="#8A8A8F"/>
                </StackPanel>
                <Button Grid.Column="1" Click="OnCancelClick" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                    <PathIcon Data="M19,6.41 L17.59,5 L12,10.59 L6.41,5 L5,6.41 L10.59,12 L5,17.59 L6.41,19 L12,13.41 L17.59,19 L19,17.59 L13.41,12 Z" Width="14" Height="14" Foreground="#8A8A8F"/>
                </Button>
            </Grid>

            <!-- Viewport & Crop Overlay -->
            <Border Grid.Row="1" Width="300" Height="300" Background="#0F000000" BorderBrush="#2DFFFFFF" BorderThickness="1" CornerRadius="12" ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Name="ViewportContainer" Background="Transparent" ClipToBounds="True">
                    <!-- Image with Render Transforms -->
                    <Image Name="AvatarImage"
                           Source="{Binding SourceImage}"
                           Width="{Binding ImageRenderWidth}"
                           Height="{Binding ImageRenderHeight}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="{Binding TransformScaleX}"
                                                ScaleY="{Binding TransformScaleY}"/>
                                <RotateTransform Angle="{Binding TransformAngle}"/>
                                <TranslateTransform X="{Binding TransformX}"
                                                    Y="{Binding TransformY}"/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>

                    <!-- Semi-transparent mask with transparent circle inside (CombinedGeometry Exclude) -->
                    <Path Fill="#A0050505" IsHitTestVisible="False">
                        <Path.Data>
                            <CombinedGeometry GeometryCombineMode="Exclude">
                                <CombinedGeometry.Geometry1>
                                    <RectangleGeometry Rect="0,0,300,300"/>
                                </CombinedGeometry.Geometry1>
                                <CombinedGeometry.Geometry2>
                                    <EllipseGeometry Center="150,150" RadiusX="120" RadiusY="120"/>
                                </CombinedGeometry.Geometry2>
                            </CombinedGeometry>
                        </Path.Data>
                    </Path>

                    <!-- Thin white circle border to mark the crop line -->
                    <Ellipse Width="240" Height="240" Stroke="White" StrokeThickness="1.5" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Zoom Slider -->
            <Grid Grid.Row="2" ColumnDefinitions="Auto, *, Auto" Margin="0,15,0,10" Width="300" HorizontalAlignment="Center">
                <TextBlock Grid.Column="0" Text="-" Foreground="#8A8A8F" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Slider Grid.Column="1" Minimum="1.0" Maximum="4.0" Value="{Binding ZoomScale, Mode=TwoWay}" VerticalAlignment="Center" Focusable="False"/>
                <TextBlock Grid.Column="2" Text="+" Foreground="#8A8A8F" FontSize="16" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </Grid>

            <!-- Transformation Controls -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16" Margin="0,0,0,20">
                <Button Classes="RoundControl" Click="OnRotateLeftClick" ToolTip.Tip="Повернуть влево">
                    <TextBlock Text="↺" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button Classes="RoundControl" Click="OnRotateRightClick" ToolTip.Tip="Повернуть вправо">
                    <TextBlock Text="↻" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button Classes="RoundControl" Click="OnFlipHorizontalClick" ToolTip.Tip="Отразить горизонтально">
                    <TextBlock Text="↔" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button Classes="RoundControl" Click="OnFlipVerticalClick" ToolTip.Tip="Отразить вертикально">
                    <TextBlock Text="↕" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </StackPanel>

            <!-- Actions -->
            <Grid Grid.Row="4" ColumnDefinitions="*, *" Width="300" HorizontalAlignment="Center">
                <Button Grid.Column="0" Click="OnCancelClick" Background="#26FF453A" BorderBrush="#FF453A" BorderThickness="1" 
                        Foreground="#FF453A" Height="36" CornerRadius="8" HorizontalAlignment="Stretch" Margin="0,0,8,0">
                    <TextBlock Text="Отмена" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button Grid.Column="1" Click="OnSaveClick" Background="#007AFF" Foreground="White" Height="36" CornerRadius="8" 
                        HorizontalAlignment="Stretch" Margin="8,0,0,0">
                    <TextBlock Text="Сохранить" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>

        </Grid>
    </Border>
</Window>

