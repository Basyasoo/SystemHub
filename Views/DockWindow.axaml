<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SystemHub.ViewModels"
        x:Class="SystemHub.Views.DockWindow"
        Width="460" Height="70"
        Title="macOS Dock"
        WindowDecorations="None"
        CanResize="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        ShowInTaskbar="False">

    <Grid VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,10">
        <!-- macOS-style glass capsule background -->
        <Border Name="DockBorder"
                Background="#FC0E0E10"
                BorderBrush="#26FFFFFF"
                BorderThickness="1"
                CornerRadius="22"
                ClipToBounds="True"
                Padding="12,6"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom">

            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <!-- Button Style and resources locally -->
                <StackPanel.Styles>
                    <Style Selector="Button.DockItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Width" Value="36"/>
                        <Setter Property="Height" Value="36"/>
                        <Setter Property="CornerRadius" Value="8"/>
                        <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
                        <Setter Property="Transitions">
                            <Transitions>
                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CircularEaseOut"/>
                            </Transitions>
                        </Setter>
                    </Style>
                    <Style Selector="Button.DockItem:pointerover">
                        <Setter Property="RenderTransform" Value="scale(1.28) translate(0px, -6px)"/>
                    </Style>
                    <Style Selector="Button.DockItem:pressed">
                        <Setter Property="RenderTransform" Value="scale(0.9)"/>
                    </Style>
                </StackPanel.Styles>

                <!-- Explorer Shortcut -->
                <Button Classes="DockItem" ToolTip.Tip="Проводник" Click="LaunchExplorer">
                    <Border Background="#1A5856D6" CornerRadius="8" Width="36" Height="36">
                        <PathIcon Data="{StaticResource IconFolder}" Width="16" Height="16" Foreground="#5856D6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Button>

                <!-- Notepad Shortcut -->
                <Button Classes="DockItem" ToolTip.Tip="Блокнот" Click="LaunchNotepad">
                    <Border Background="#1AFF9500" CornerRadius="8" Width="36" Height="36">
                        <PathIcon Data="{StaticResource IconEdit}" Width="16" Height="16" Foreground="#FF9500" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Button>

                <!-- Calculator Shortcut -->
                <Button Classes="DockItem" ToolTip.Tip="Калькулятор" Click="LaunchCalc">
                    <Border Background="#1AFF2D55" CornerRadius="8" Width="36" Height="36">
                        <PathIcon Data="{StaticResource IconSystem}" Width="16" Height="16" Foreground="#FF2D55" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Button>

                <!-- Browser Shortcut -->
                <Button Classes="DockItem" ToolTip.Tip="Браузер" Click="LaunchBrowser">
                    <Border Background="#1A0A84FF" CornerRadius="8" Width="36" Height="36">
                        <PathIcon Data="{StaticResource IconHumidity}" Width="16" Height="16" Foreground="#0A84FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Button>

                <!-- Separator Line -->
                <Border Width="1" Height="24" Background="#26FFFFFF" VerticalAlignment="Center"/>

                <!-- Yandex Music Launcher -->
                <Button Classes="DockItem" ToolTip.Tip="Яндекс.Музыка" Click="LaunchYandex">
                    <Border Background="#1AFFCC00" CornerRadius="8" Width="36" Height="36">
                        <PathIcon Data="{StaticResource YandexMusicLogo}" Width="14" Height="14" Foreground="#FFCC00" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Button>

                <!-- Spotify Launcher -->
                <Button Classes="DockItem" ToolTip.Tip="Spotify" Click="LaunchSpotify">
                    <Border Background="#1A30D158" CornerRadius="8" Width="36" Height="36">
                        <PathIcon Data="{StaticResource SpotifyLogo}" Width="15" Height="15" Foreground="#30D158" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Button>

                <!-- Settings / App Toggle -->
                <Button Classes="DockItem" ToolTip.Tip="SystemHub" Click="LaunchApp">
                    <Border Background="#1AAF52DE" CornerRadius="8" Width="36" Height="36">
                        <PathIcon Data="{StaticResource IconSettings}" Width="16" Height="16" Foreground="#AF52DE" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>

