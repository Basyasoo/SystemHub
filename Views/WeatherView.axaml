<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MacStyleHub.ViewModels"
             xmlns:views="using:MacStyleHub.Views"
             xmlns:services="using:MacStyleHub.Services"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="550"
             x:Class="MacStyleHub.Views.WeatherView"
             x:DataType="vm:WeatherViewModel">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30" Spacing="25">
            <!-- Header -->
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Spacing="5">
                    <TextBlock Text="{Binding WeatherHeader, Source={x:Static services:LocalizationService.Instance}}" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" LetterSpacing="-0.5"/>
                    <TextBlock Text="{Binding WeatherDesc, Source={x:Static services:LocalizationService.Instance}}" FontSize="14" Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
                
                <Button Grid.Column="1" Classes="SystemButton" Command="{Binding LoadWeatherCommand}" Content="{Binding WeatherRefresh, Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center"/>
            </Grid>

            <!-- Location Settings Card -->
            <Border Classes="GlassCard" HorizontalAlignment="Stretch" Padding="18">
                <StackPanel Spacing="15">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding WeatherLocationSettingsHeader, Source={x:Static services:LocalizationService.Instance}}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{Binding WeatherLocationSettingsDesc, Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- City Search Bar -->
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBox Grid.Column="0"
                                 Text="{Binding SearchQuery, Mode=TwoWay}"
                                 PlaceholderText="{Binding WeatherSearchWatermark, Source={x:Static services:LocalizationService.Instance}}"
                                 Background="#222C2C2E"
                                 BorderBrush="{DynamicResource BorderGray}"
                                 CornerRadius="6"
                                 VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Classes="AccentButton"
                                Command="{Binding SearchCityCommand}"
                                Content="{Binding WeatherSearchBtn, Source={x:Static services:LocalizationService.Instance}}"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Search Results -->
                    <Border IsVisible="{Binding IsSearchResultsVisible}"
                            Background="{DynamicResource CardBg}"
                            BorderBrush="{DynamicResource BorderGray}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="5">
                        <StackPanel Spacing="5">
                            <TextBlock Text="{Binding WeatherSearchResultsTitle, Source={x:Static services:LocalizationService.Instance}}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Margin="8,4,8,2"/>
                            <ListBox ItemsSource="{Binding SearchResults}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     MaxHeight="200">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*, Auto" Margin="5,2">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       FontSize="13"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,10,0"/>
                                            <Button Grid.Column="1"
                                                    Classes="SystemButton"
                                                    Content="{Binding WeatherCoordinatesBtn, Source={x:Static services:LocalizationService.Instance}}"
                                                    Command="{Binding $parent[UserControl].((vm:WeatherViewModel)DataContext).SelectCityCommand}"
                                                    CommandParameter="{Binding}"
                                                    Padding="10,4"
                                                    FontSize="11"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Main Weather Card -->
            <Border Classes="GlassCard" HorizontalAlignment="Stretch" Padding="25" MinHeight="230" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderGray}">
                <Grid RowDefinitions="Auto, *, Auto" ColumnDefinitions="*, Auto">
                    <!-- Loading overlay -->
                    <ProgressBar Grid.RowSpan="3" Grid.ColumnSpan="2" IsIndeterminate="True" IsVisible="{Binding IsLoading}" VerticalAlignment="Top" Background="Transparent" Foreground="{DynamicResource AccentBlue}"/>
                    
                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4" IsVisible="{Binding !IsLoading}">
                        <Grid ColumnDefinitions="Auto, *" Margin="0,0,10,0">
                            <PathIcon Grid.Column="0" Data="{StaticResource IconLocation}" Width="14" Height="14" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding CityLocalized}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                        <TextBlock Text="{Binding ConditionLocalized}" FontSize="15" Foreground="{DynamicResource TextSecondary}" FontWeight="Medium"/>
                    </StackPanel>

                    <!-- Large temperature display -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,5" VerticalAlignment="Center" IsVisible="{Binding !IsLoading}">
                        <TextBlock Text="{Binding Temperature, StringFormat={}{0:0}}" FontSize="64" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="°C" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="2,6,0,0" VerticalAlignment="Top"/>
                    </StackPanel>

                    <!-- Large weather condition SVG icon -->
                    <views:WeatherIcon Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Icon="{Binding Icon}" Width="110" Height="110" StrokeThickness="3.5" VerticalAlignment="Center" IsVisible="{Binding !IsLoading}"/>

                    <!-- Details strip at bottom -->
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="40" Margin="0,10,0,0" IsVisible="{Binding !IsLoading}">
                        <StackPanel Spacing="3">
                            <TextBlock Text="{Binding WeatherHumidity, Source={x:Static services:LocalizationService.Instance}}" FontSize="10" Foreground="{DynamicResource TextSecondary}" FontWeight="Bold" LetterSpacing="0.5"/>
                            <TextBlock Text="{Binding Humidity, StringFormat={}{0}%}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>
                        <StackPanel Spacing="3">
                            <TextBlock Text="{Binding WeatherWind, Source={x:Static services:LocalizationService.Instance}}" FontSize="10" Foreground="{DynamicResource TextSecondary}" FontWeight="Bold" LetterSpacing="0.5"/>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{Binding WindSpeed, StringFormat={}{0:F1}}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="{Binding WeatherWindUnit, Source={x:Static services:LocalizationService.Instance}}" FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Bottom"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Spacing="3">
                            <TextBlock Text="{Binding WeatherFeelsLike, Source={x:Static services:LocalizationService.Instance}}" FontSize="10" Foreground="{DynamicResource TextSecondary}" FontWeight="Bold" LetterSpacing="0.5"/>
                            <TextBlock Text="{Binding Temperature, StringFormat={}{0:0} °C}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 7-Day Forecast -->
            <StackPanel Spacing="12">
                <TextBlock Text="{Binding WeatherForecastHeader, Source={x:Static services:LocalizationService.Instance}}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,5,0,0"/>
                
                <ItemsControl ItemsSource="{Binding Forecast}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="SystemCard" Margin="4" Padding="14" Height="165" HorizontalAlignment="Stretch" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderGray}">
                                <Grid RowDefinitions="Auto, Auto, Auto, *">
                                    <TextBlock Grid.Row="0" Text="{Binding DayLocalized}" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" FontSize="13"/>
                                    
                                    <!-- Dynamic SVG Vector Icon for forecast item -->
                                    <views:WeatherIcon Grid.Row="1" Icon="{Binding Icon}" Width="36" Height="36" StrokeThickness="2.2" HorizontalAlignment="Center" Margin="0,8"/>
                                    
                                    <TextBlock Grid.Row="2" Text="{Binding ConditionLocalized}" HorizontalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    
                                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                        <TextBlock Text="{Binding MaxTemp, StringFormat={}{0:0}°}" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Text=" / " Foreground="{DynamicResource TextSecondary}" FontSize="13"/>
                                        <TextBlock Text="{Binding MinTemp, StringFormat={}{0:0}°}" Foreground="{DynamicResource TextSecondary}" FontSize="13"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>

        <!-- Glassmorphic Modal Overlay -->
        <Grid Background="#A0000000" 
              IsVisible="{Binding IsClipboardDialogVisible}"
              HorizontalAlignment="Stretch" 
              VerticalAlignment="Stretch">
            
            <Border Classes="GlassCard" 
                    Width="480" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center" 
                    Padding="25" 
                    Background="#CC1C1C1E" 
                    BorderBrush="#33FFFFFF" 
                    BorderThickness="1" 
                    CornerRadius="12"
                    BoxShadow="0 8 24 0 #80000000">
                <StackPanel Spacing="18">
                    <!-- Title -->
                    <TextBlock Text="{Binding WeatherLocationDialogTitle, Source={x:Static services:LocalizationService.Instance}}" 
                               FontSize="18" 
                               FontWeight="SemiBold" 
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                    
                    <!-- Description / Guide -->
                    <TextBlock Text="{Binding WeatherLocationDialogDesc, Source={x:Static services:LocalizationService.Instance}}" 
                               FontSize="12" 
                               Foreground="#FFD1D1D6" 
                               TextWrapping="Wrap"
                               LineHeight="18"/>

                    <!-- Input TextBox -->
                     <TextBox Text="{Binding ClipboardText, Mode=TwoWay}"
                              PlaceholderText="{Binding WeatherCoordinatesWatermark, Source={x:Static services:LocalizationService.Instance}}"
                              Background="#442C2C2E"
                              Foreground="White"
                              BorderBrush="#44FFFFFF"
                              CornerRadius="6"
                              Padding="10,8"
                              Height="60"
                              AcceptsReturn="True"
                              TextWrapping="Wrap"/>
                    
                    <!-- Message / Status -->
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding WeatherLocationDialogSuccess, Source={x:Static services:LocalizationService.Instance}}" 
                                   Foreground="#FF30D158" 
                                   FontSize="12" 
                                   IsVisible="{Binding IsClipboardDataValid}"
                                   FontWeight="Medium"/>
                        <TextBlock Text="{Binding WeatherCoordinatesError, Source={x:Static services:LocalizationService.Instance}}" 
                                   Foreground="#FFFF453A" 
                                   FontSize="12" 
                                   IsVisible="{Binding !IsClipboardDataValid}"
                                   FontWeight="Medium"/>
                    </StackPanel>

                    <!-- Buttons -->
                    <Grid ColumnDefinitions="*, *" RowDefinitions="Auto">
                        <Button Grid.Column="0" 
                                Classes="SystemButton" 
                                Content="{Binding WeatherLocationDialogCancel, Source={x:Static services:LocalizationService.Instance}}" 
                                Command="{Binding CloseClipboardDialogCommand}"
                                Margin="0,0,8,0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"/>
                        
                        <Button Grid.Column="1" 
                                Classes="SystemButton" 
                                Content="{Binding WeatherCoordinatesBtn, Source={x:Static services:LocalizationService.Instance}}" 
                                Command="{Binding ApplyClipboardLocationCommand}"
                                IsEnabled="{Binding IsClipboardDataValid}"
                                Background="{StaticResource AccentBlue}"
                                Foreground="White"
                                Margin="8,0,0,0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
