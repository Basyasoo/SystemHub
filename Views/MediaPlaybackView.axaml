<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MacStyleHub.ViewModels"
             xmlns:services="using:MacStyleHub.Services"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="550"
             x:Class="MacStyleHub.Views.MediaPlaybackView"
             x:DataType="vm:MediaPlaybackViewModel">

    <UserControl.Resources>
        <!-- Phosphor Icons Paths local to MediaPlaybackView -->
        <StreamGeometry x:Key="PhPlay">M80,224a16,16,0,0,1-16-16V48a16,16,0,0,1,24.16-13.8L224,114.2a16,16,0,0,1,0,27.6L88.16,221.8A15.82,15.82,0,0,1,80,224Z</StreamGeometry>
        <StreamGeometry x:Key="PhPause">M200,48V208a16,16,0,0,1-16,16H152a16,16,0,0,1-16-16V48a16,16,0,0,1,16-16h32A16,16,0,0,1,200,48ZM104,32H72A16,16,0,0,0,56,48V208a16,16,0,0,0,16,16h32a16,16,0,0,0,16-16V48A16,16,0,0,0,104,32Z</StreamGeometry>
        <StreamGeometry x:Key="PhNext">M208,40V216a8,8,0,0,1-16,0V139.73L74.63,222A16,16,0,0,1,48,209.12V46.88A16,16,0,0,1,74.63,34L192,116.27V40a8,8,0,0,1,16,0Z</StreamGeometry>
        <StreamGeometry x:Key="PhPrev">M208,209.12A16,16,0,0,1,181.37,222L64,139.73V216a8,8,0,0,1-16,0V40a8,8,0,0,1,16,0V116.27L181.37,34A16,16,0,0,1,208,46.88Z</StreamGeometry>
        <StreamGeometry x:Key="PhMusic">M216,40V168a48,48,0,1,1-48-48,47.4,47.4,0,0,1,32,12.33V80L96,96v88a48,48,0,1,1-48-48,47.4,47.4,0,0,1,32,12.33V56a16,16,0,0,1,12.48-15.6l96-24A16,16,0,0,1,216,40ZM120,184a32,32,0,1,0,32,32A32,32,0,0,0,120,184ZM48,184a32,32,0,1,0,32,32A32,32,0,0,0,48,184Z</StreamGeometry>
        <StreamGeometry x:Key="SpotifyLogo">M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0m3.669 11.538a.5.5 0 0 1-.686.165c-1.879-1.147-4.243-1.407-7.028-.77a.499.499 0 0 1-.222-.973c3.048-.696 5.662-.397 7.77.892a.5.5 0 0 1 .166.686m.979-2.178a.624.624 0 0 1-.858.205c-2.15-1.321-5.428-1.704-7.972-.932a.625.625 0 0 1-.362-1.194c2.905-.881 6.517-.454 8.986 1.063a.624.624 0 0 1 .206.858m.084-2.268C10.154 5.56 5.9 5.419 3.438 6.166a.748.748 0 1 1-.434-1.432c2.825-.857 7.523-.692 10.492 1.07a.747.747 0 1 1-.764 1.288</StreamGeometry>
        <StreamGeometry x:Key="YandexMusicLogo">m 51.62106,27.246576 -0.15602,-0.775668 -6.59622,-1.152272 3.832962,-5.185702 -0.445616,-0.487482 -5.637864,2.70361 0.712978,-7.180076 -0.57941,-0.332162 -3.431792,5.805814 -3.85495,-8.642522 h -0.668534 l 0.913678,8.354572 -9.69351,-7.756214 -0.824558,0.243742 7.464988,9.37398 -14.774185,-4.919736 -0.668534,0.753444 13.192207,7.512706 -18.206214,1.506424 -0.200467,1.13052 18.919191,2.060806 -15.77722,13.05256 0.668534,0.908524 18.785388,-10.215842 -3.721146,17.994282 h 1.1366 l 7.19762,-16.930662 4.389916,13.252084 0.78011,-0.598354 -1.805132,-13.473608 6.841128,7.756212 0.445846,-0.709238 -5.236928,-9.617718 7.309196,2.703608 0.0669,-0.819878 -6.551544,-4.831084 6.172832,-1.484668 z</StreamGeometry>
        <StreamGeometry x:Key="IconList">M32,64a8,8,0,0,1,8-8H216a8,8,0,0,1,0,16H40A8,8,0,0,1,32,64Zm8,56H216a8,8,0,0,0,0-16H40a8,8,0,0,0,0,16Zm176,32H40a8,8,0,0,0,0,16H216a8,8,0,0,0,0-16Z</StreamGeometry>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.PlayerCard">
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Grid.ColumnSpan" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style Selector="Border.PlayerCard.Centered">
            <Setter Property="Grid.ColumnSpan" Value="2"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Width" Value="420"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style Selector="Border.SessionsCard">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform" Value="scale(0.96) translate(50px, 0)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.4" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.4" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.SessionsCard[IsVisible=True]">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="RenderTransform" Value="scale(1.0) translate(0, 0)"/>
        </Style>

        <Style Selector="ItemsControl Border.SystemCard">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="ItemsControl Border.SystemCard.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>

        <Style Selector="Button.SpotifyLaunch">
            <Setter Property="Background" Value="#1DB954"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="0.34, 1.56, 0.64, 1"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.SpotifyLaunch:pointerover">
            <Setter Property="Background" Value="#22C55E"/>
            <Setter Property="RenderTransform" Value="scale(1.03)"/>
        </Style>
        <Style Selector="Button.SpotifyLaunch:pressed">
            <Setter Property="Background" Value="#16A34A"/>
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
        </Style>

        <Style Selector="Button.YandexLaunch">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Offset="0" Color="#FFCC00"/>
                    <GradientStop Offset="1" Color="#FF5C15"/>
                </LinearGradientBrush>
            </Setter>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="0.34, 1.56, 0.64, 1"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.YandexLaunch:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.03)"/>
        </Style>
        <Style Selector="Button.YandexLaunch:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
        </Style>

        <!-- Custom macOS-style Volume Slider -->
        <Style Selector="Slider.VolumeSlider">
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ClipToBounds" Value="False"/>
        </Style>
        <Style Selector="Slider.VolumeSlider /template/ Border#SliderContainer">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ClipToBounds" Value="False"/>
        </Style>
        <Style Selector="Slider.VolumeSlider /template/ Track#PART_Track">
            <Setter Property="Grid.Row" Value="0"/>
            <Setter Property="Grid.RowSpan" Value="3"/>
            <Setter Property="ClipToBounds" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Slider.VolumeSlider /template/ Grid">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="ClipToBounds" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Slider.VolumeSlider /template/ ContentPresenter">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Slider.VolumeSlider /template/ TickBar">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="TextBlock.VolumeText">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Grid.VolumeContainer:pointerover TextBlock.VolumeText">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Slider.VolumeSlider /template/ RepeatButton#PART_DecreaseButton">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="TrackBorder" Background="{TemplateBinding Background}" Height="3" CornerRadius="1.5 0 0 1.5" VerticalAlignment="Center"/>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Slider.VolumeSlider /template/ RepeatButton#PART_IncreaseButton">
            <Setter Property="Background" Value="#3A3A3C"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="TrackBorder" Background="{TemplateBinding Background}" Height="3" CornerRadius="0 1.5 1.5 0" VerticalAlignment="Center"/>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Slider.VolumeSlider /template/ Thumb">
            <Setter Property="Width" Value="0"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="ClipToBounds" Value="False"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="White" Width="14" Height="14" CornerRadius="7" VerticalAlignment="Center"/>
                </ControlTemplate>
            </Setter>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                    <DoubleTransition Property="Width" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Grid.VolumeContainer:pointerover Slider.VolumeSlider /template/ Thumb">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Width" Value="14"/>
        </Style>
        <Style Selector="Slider.VolumeSlider /template/ Thumb:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.15)"/>
        </Style>

        <!-- Vinyl Record Visualizer Animations -->
        <Style Selector="Grid.VinylRecord.playing Grid.VinylDisk">
            <Style.Animations>
                <Animation Duration="0:0:8" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Custom macOS-style Flyout presenter to remove default native padding/borders -->
        <Style Selector="FlyoutPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <!-- Custom Equalizer Sliders Style -->
        <Style Selector="Slider.EqSlider">
            <Setter Property="Width" Value="24"/>
            <Setter Property="MinWidth" Value="24"/>
            <Setter Property="Height" Value="140"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Slider.EqSlider /template/ Border#TrackBackground">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Slider.EqSlider /template/ RepeatButton#PART_DecreaseButton">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="TrackBorder" Background="#555555" Width="2" HorizontalAlignment="Center"/>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Slider.EqSlider /template/ RepeatButton#PART_IncreaseButton">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="TrackBorder" Background="#555555" Width="2" HorizontalAlignment="Center"/>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Slider.EqSlider Thumb">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Background" Value="#222222"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="7"/>
        </Style>
        <Style Selector="Slider.EqSlider Thumb:pointerover">
            <Setter Property="Background" Value="#2C2C2C"/>
            <Setter Property="BorderBrush" Value="#359AFF"/>
        </Style>
        <Style Selector="Slider.EqSlider Thumb:pressed">
            <Setter Property="Background" Value="#151515"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
        </Style>

        <!-- Custom AccentBlue ToggleSwitch Style -->
        <Style Selector="ToggleSwitch.EqToggle:checked /template/ Border#SwitchKnob">
            <Setter Property="Background" Value="Black"/>
        </Style>
        <Style Selector="ToggleSwitch.EqToggle:checked /template/ Border#SwitchKnobBounds">
            <Setter Property="Background" Value="{DynamicResource AccentBlue}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
        </Style>

        <!-- Equalizer Animated Panel Styles -->
        <Style Selector="Border.eq-card-left">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Width" Value="370"/>
            <Setter Property="Height" Value="420"/>
            <Setter Property="MinHeight" Value="420"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="RenderTransform" Value="scale(1) translate(0, 0)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.35" Easing="CubicEaseOut"/>
                    <DoubleTransition Property="Width" Duration="0:0:0.35" Easing="CubicEaseOut"/>
                    <DoubleTransition Property="Height" Duration="0:0:0.35" Easing="CubicEaseOut"/>
                    <DoubleTransition Property="MinHeight" Duration="0:0:0.35" Easing="CubicEaseOut"/>
                    <ThicknessTransition Property="Margin" Duration="0:0:0.35" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.35" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.eq-card-left.hidden">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Width" Value="0"/>
            <Setter Property="Height" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="RenderTransform" Value="scale(0.9) translate(-20px, 0)"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <Style Selector="Border.eq-card-right">
            <Setter Property="Width" Value="380"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <Style Selector="StackPanel.eq-controls-right">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="MaxHeight" Value="400"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                    <DoubleTransition Property="MaxHeight" Duration="0:0:0.35" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="StackPanel.eq-controls-right.hidden">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="MaxHeight" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30" Spacing="25">
            <!-- Header -->
            <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                <TextBlock Grid.Column="0" Text="{Binding PlayerHeader, Source={x:Static services:LocalizationService.Instance}}" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" LetterSpacing="-0.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,15,0"/>
                
                <!-- Grouped buttons on the right to prevent overlaps -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button Classes="SpotifyLaunch" Height="36" ToolTip.Tip="Spotify">
                        <Button.Flyout>
                            <Flyout Placement="Bottom" ShowMode="Transient">
                                <Border Padding="16" Background="#E51C1C1E" CornerRadius="12" BorderBrush="#33FFFFFF" BorderThickness="1" BoxShadow="0 8 24 0 #60000000">
                                    <StackPanel Spacing="10" Width="180">
                                        <TextBlock Text="{Binding PlayerOpenSpotify, Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <Button Classes="SystemButton" Content="{Binding PlayerOpenApp, Source={x:Static services:LocalizationService.Instance}}" Command="{Binding LaunchSpotifyAppCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                        <Button Classes="SystemButton" Content="{Binding PlayerOpenWeb, Source={x:Static services:LocalizationService.Instance}}" Command="{Binding LaunchSpotifyWebCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource SpotifyLogo}" Width="14" Height="14" Foreground="White"/>
                            <TextBlock Text="Spotify" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Classes="YandexLaunch" Height="36" ToolTip.Tip="{Binding YandexMusicLabel, Source={x:Static services:LocalizationService.Instance}}">
                        <Button.Flyout>
                            <Flyout Placement="Bottom" ShowMode="Transient">
                                <Border Padding="16" Background="#E51C1C1E" CornerRadius="12" BorderBrush="#33FFFFFF" BorderThickness="1" BoxShadow="0 8 24 0 #60000000">
                                    <StackPanel Spacing="10" Width="180">
                                        <TextBlock Text="{Binding PlayerOpenYandex, Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <Button Classes="SystemButton" Content="{Binding PlayerOpenApp, Source={x:Static services:LocalizationService.Instance}}" Command="{Binding LaunchYandexMusicAppCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                        <Button Classes="SystemButton" Content="{Binding PlayerOpenWeb, Source={x:Static services:LocalizationService.Instance}}" Command="{Binding LaunchYandexMusicWebCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource YandexMusicLogo}" Width="14" Height="14" Foreground="#111111"/>
                            <TextBlock Text="{Binding YandexMusicLabel, Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="SemiBold" Foreground="#111111"/>
                        </StackPanel>
                    </Button>

                    <Button Classes="SystemButton" 
                            Command="{Binding ToggleSessionsCommand}" 
                            IsVisible="{Binding !IsSessionsExpanded}" 
                            VerticalAlignment="Center"
                            ToolTip.Tip="{Binding PlayerSessionsToggle, Source={x:Static services:LocalizationService.Instance}}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconList}" Width="16" Height="16" Foreground="{DynamicResource AccentBlue}"/>
                            <TextBlock Text="{Binding PlayerActiveSessions, Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Classes="SystemButton" 
                            Command="{Binding ToggleEqualizerCommand}" 
                            VerticalAlignment="Center"
                            ToolTip.Tip="Открыть/закрыть эквалайзер">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconSettings}" Width="16" Height="16" Foreground="{DynamicResource AccentBlue}"/>
                            <TextBlock Text="Эквалайзер" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="*, 1.2*" RowDefinitions="Auto">
                
                <!-- Left Column: Active Player Visualizer & Controller -->
                <Border Grid.Column="0" Classes="GlassCard PlayerCard" Classes.Centered="{Binding !IsSessionsExpanded}" Padding="25" MinHeight="420" VerticalAlignment="Top">
                    <Grid RowDefinitions="*, Auto, Auto, Auto">
                        
                        <!-- Vinyl Disk/Waveform Visualizer -->
                        <Grid Grid.Row="0" Classes="VinylRecord" Classes.playing="{Binding IsPlaying}" Width="180" Height="180" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,20">
                            <!-- Background shadow glow (dynamically scaled and faded by audio output peaks) -->
                            <Ellipse Classes="GlowRing" Width="170" Height="170" Fill="#10ffffff" Stroke="{StaticResource AccentBlue}" StrokeThickness="1" Opacity="{Binding GlowRingOpacity}" RenderTransformOrigin="50%,50%">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding GlowRingScale}" ScaleY="{Binding GlowRingScale}"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <!-- Rotating Disk Assembly -->
                            <Grid Classes="VinylDisk" Width="160" Height="160" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="50%,50%">
                                <!-- We apply the continuous rotation animation to VinylDisk, and scale the inner Grid dynamically -->
                                <Grid Width="160" Height="160" RenderTransformOrigin="50%,50%">
                                    <Grid.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding VinylDiskScale}" ScaleY="{Binding VinylDiskScale}"/>
                                    </Grid.RenderTransform>
                                    <!-- Outer Vinyl Disk -->
                                    <Ellipse Width="160" Height="160" Fill="#111112" Stroke="#2C2C2E" StrokeThickness="4"/>
                                    <!-- Inner Grooves -->
                                    <Ellipse Width="120" Height="120" Stroke="#1C1C1E" StrokeThickness="1" Fill="Transparent"/>
                                    <Ellipse Width="90" Height="90" Stroke="#1C1C1E" StrokeThickness="1" Fill="Transparent"/>
                                    <!-- Center Label -->
                                    <Ellipse Width="50" Height="50" Fill="{StaticResource AccentBlue}"/>
                                    <!-- Fallback Music icon when no art -->
                                    <PathIcon Data="{StaticResource PhMusic}" Width="18" Height="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding AlbumArt, Converter={x:Static ObjectConverters.IsNull}}"/>
                                    <!-- Album Art Image -->
                                    <Ellipse Width="50" Height="50" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding AlbumArt, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <Ellipse.Fill>
                                            <ImageBrush Source="{Binding AlbumArt}" Stretch="UniformToFill"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </Grid>
                            </Grid>
                        </Grid>
 
                        <!-- Track Info -->
                        <StackPanel Grid.Row="1" Spacing="5" HorizontalAlignment="Center" Margin="0,0,0,20" IsVisible="{Binding HasMedia}">
                            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="2"/>
                            <TextBlock Text="{Binding Artist}" FontSize="14" Foreground="{DynamicResource TextSecondary}" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Border Background="{DynamicResource BorderGray}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" Margin="0,5,0,0">
                                <TextBlock Text="{Binding PlayerName}" FontSize="10" Foreground="{DynamicResource TextSecondary}" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
 
                        <!-- Fallback/No Media State -->
                        <StackPanel Grid.Row="1" Spacing="10" HorizontalAlignment="Center" Margin="0,10,0,30" IsVisible="{Binding !HasMedia}">
                            <TextBlock Text="{Binding PlayerNoActive, Source={x:Static services:LocalizationService.Instance}}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" TextAlignment="Center"/>
                            <TextBlock Text="{Binding PlayerLaunchRecommendation, Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="#5E5E62" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="220"/>
                        </StackPanel>
 
                        <!-- Controls -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="25" HorizontalAlignment="Center" Margin="0,0,0,10">
                            <!-- Prev Button -->
                            <Button Width="40" Height="40" Padding="0" CornerRadius="20" Background="Transparent" BorderThickness="0"
                                    Command="{Binding PrevCommand}" ToolTip.Tip="{Binding ToolTipPrev, Source={x:Static services:LocalizationService.Instance}}">
                                <PathIcon Data="{StaticResource PhPrev}" Width="16" Height="16" Foreground="{DynamicResource TextPrimary}"/>
                            </Button>
                            
                            <!-- Play/Pause Button -->
                            <Button Width="56" Height="56" Padding="0" CornerRadius="28" Classes="SystemButton"
                                    Command="{Binding TogglePlayCommand}" ToolTip.Tip="{Binding ToolTipPlayPause, Source={x:Static services:LocalizationService.Instance}}">
                                <Grid>
                                    <PathIcon Data="{StaticResource PhPause}" Width="20" Height="20" Foreground="{StaticResource AccentBlue}" IsVisible="{Binding IsPlaying}"/>
                                    <PathIcon Data="{StaticResource PhPlay}" Width="20" Height="20" Foreground="{DynamicResource TextPrimary}" Margin="2,0,0,0" IsVisible="{Binding !IsPlaying}"/>
                                </Grid>
                            </Button>
                            
                            <!-- Next Button -->
                            <Button Width="40" Height="40" Padding="0" CornerRadius="20" Background="Transparent" BorderThickness="0"
                                    Command="{Binding NextCommand}" ToolTip.Tip="{Binding ToolTipNext, Source={x:Static services:LocalizationService.Instance}}">
                                <PathIcon Data="{StaticResource PhNext}" Width="16" Height="16" Foreground="{DynamicResource TextPrimary}"/>
                            </Button>
                        </StackPanel>
 
                        <!-- Volume Controls -->
                        <Grid Grid.Row="3" Classes="VolumeContainer" ColumnDefinitions="Auto, *, Auto" Margin="20,10,20,10" VerticalAlignment="Center" Background="Transparent" ClipToBounds="False">
                            <!-- Mute Toggle Button -->
                            <Button Command="{Binding ToggleMuteCommand}" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="16" ToolTip.Tip="{Binding ToolTipVolume, Source={x:Static services:LocalizationService.Instance}}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Mute Icon -->
                                    <Path Data="M3,7 H6 L9,4 V16 L6,13 H3 Z M 12.5,8.5 L 15.5,11.5 M 15.5,8.5 L 12.5,11.5" 
                                          Stroke="{DynamicResource TextPrimary}" 
                                          StrokeThickness="2.0" 
                                          StrokeJoin="Round" 
                                          StrokeLineCap="Round" 
                                          Fill="Transparent" 
                                          Width="16" 
                                          Height="16" 
                                          Stretch="Uniform" 
                                          IsVisible="{Binding IsMuted}"/>
                                    <!-- Unmuted Icon -->
                                    <Path Data="M3,7 H6 L9,4 V16 L6,13 H3 Z M 12,7 A 3.5,3.5 0 0,1 12,13" 
                                          Stroke="{DynamicResource TextPrimary}" 
                                          StrokeThickness="2.0" 
                                          StrokeJoin="Round" 
                                          StrokeLineCap="Round" 
                                          Fill="Transparent" 
                                          Width="16" 
                                          Height="16" 
                                          Stretch="Uniform" 
                                          IsVisible="{Binding !IsMuted}"/>
                                </Grid>
                            </Button>
                            
                            <!-- Volume Slider -->
                            <Slider Grid.Column="1" 
                                    Classes="VolumeSlider" 
                                    Classes.Muted="{Binding IsMuted}"
                                    Value="{Binding DisplayVolume, Mode=TwoWay}" 
                                    Minimum="0" 
                                    Maximum="100" 
                                    Margin="10,0,10,0" 
                                    VerticalAlignment="Center"/>
                            
                            <!-- Volume Percent Text -->
                            <TextBlock Grid.Column="2" Classes="VolumeText" Text="{Binding Volume, StringFormat={}{0:0}%}" Width="40" TextAlignment="Right" FontSize="12" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        <!-- Volume Controls closing Grid -->
                        </Grid>
                    </Grid>
                </Border>

                <!-- Right Column: List of All Active Media Sessions & Volume Mixer -->
                <Border Grid.Column="1" Classes="GlassCard SessionsCard" Margin="12,0,0,0" Padding="25" MinHeight="420" VerticalAlignment="Stretch" IsVisible="{Binding IsSessionsExpanded}">
                    <StackPanel Spacing="15">
                        <!-- Header with Collapse Button -->
                        <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,5">
                            <TextBlock Grid.Column="0" Text="{Binding PlayerActiveSessions, Source={x:Static services:LocalizationService.Instance}}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Classes="SystemButton" Padding="8,6" Command="{Binding ToggleSessionsCommand}" ToolTip.Tip="{Binding ToolTipCollapse, Source={x:Static services:LocalizationService.Instance}}">
                                <PathIcon Data="{StaticResource IconClose}" Width="10" Height="10"/>
                            </Button>
                        </Grid>
                        
                        <!-- List of active sessions -->
                        <ItemsControl ItemsSource="{Binding ActiveSessions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MediaSessionInfo">
                                    <Border Classes="SystemCard" Classes.selected="{Binding IsSelected}" Margin="0,0,0,10" Padding="14" PointerPressed="OnSessionCardPointerPressed">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <!-- Info -->
                                            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center" Margin="0,0,15,0">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Border Background="{DynamicResource BorderGray}" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="{Binding Name}" FontSize="10" Foreground="{DynamicResource AccentBlue}" FontWeight="Bold"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Artist}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <!-- Controls -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <!-- Prev -->
                                                <Button Width="30" Height="30" Padding="0" CornerRadius="15" Background="Transparent" BorderThickness="0"
                                                        Command="{Binding PrevCommand}">
                                                    <PathIcon Data="{StaticResource PhPrev}" Width="12" Height="12" Foreground="{DynamicResource TextPrimary}"/>
                                                </Button>
                                                
                                                <!-- Play/Pause -->
                                                <Button Width="34" Height="34" Padding="0" CornerRadius="17" Classes="SystemButton"
                                                        Command="{Binding TogglePlayCommand}">
                                                    <Grid>
                                                        <PathIcon Data="{StaticResource PhPause}" Width="12" Height="12" Foreground="{StaticResource AccentBlue}" IsVisible="{Binding IsPlaying}"/>
                                                        <PathIcon Data="{StaticResource PhPlay}" Width="12" Height="12" Foreground="{DynamicResource TextPrimary}" Margin="1,0,0,0" IsVisible="{Binding !IsPlaying}"/>
                                                    </Grid>
                                                </Button>
                                                
                                                <!-- Next -->
                                                <Button Width="30" Height="30" Padding="0" CornerRadius="15" Background="Transparent" BorderThickness="0"
                                                        Command="{Binding NextCommand}">
                                                    <PathIcon Data="{StaticResource PhNext}" Width="12" Height="12" Foreground="{DynamicResource TextPrimary}"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Equalizer block -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" IsVisible="{Binding $parent[UserControl].((vm:MediaPlaybackViewModel)DataContext).IsEqualizerExpanded}" DataContext="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToolsVM}" Margin="0,15,0,0">
                <!-- Left Column: Visualizer & Presets -->
                <Border Classes="GlassCard eq-card-left" Classes.hidden="{Binding !IsEqualizerEnabled}" ClipToBounds="True">
                    <Grid RowDefinitions="Auto, *, Auto" Margin="16">
                        <!-- Header -->
                        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,15">
                            <TextBlock Text="Визуализатор спектра" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="Анализ и отображение частот воспроизведения системного звука" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>

                        <!-- Visualizer Area -->
                        <Border Grid.Row="1" CornerRadius="12" Background="#0C000000" BorderBrush="{DynamicResource BorderGray}" BorderThickness="1.5" ClipToBounds="True" Height="220">
                            <Canvas Name="VisualizerCanvas" Width="310" Height="200" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Presets Area -->
                        <StackPanel Grid.Row="2" Spacing="8" Margin="0,10,0,0">
                            <TextBlock Text="Пресеты эквалайзера:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                            <Grid ColumnDefinitions="*, Auto, Auto, Auto, Auto">
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding EqualizerPresets}" 
                                          SelectedItem="{Binding SelectedEqualizerPreset}" 
                                          HorizontalAlignment="Stretch" 
                                          Height="32" 
                                          CornerRadius="6">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="vm:EqualizerPreset">
                                            <TextBlock Text="{Binding Name}" FontSize="12"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                
                                <Button Grid.Column="1" 
                                        Command="{Binding UpdateEqualizerPresetCommand}" 
                                        Height="32" 
                                        Width="32" 
                                        Margin="6,0,0,0" 
                                        Classes="SystemButton"
                                        ToolTip.Tip="Сохранить изменения в пресет"
                                        IsVisible="{Binding IsCustomPresetSelected}">
                                    <PathIcon Data="{StaticResource IconCheck}" Width="13" Height="13" Foreground="{DynamicResource AccentBlue}"/>
                                </Button>

                                <Button Grid.Column="2" 
                                        Command="{Binding DeleteEqualizerPresetCommand}" 
                                        Height="32" 
                                        Width="32" 
                                        Margin="6,0,0,0" 
                                        Classes="SystemButton"
                                        ToolTip.Tip="Удалить пресет"
                                        IsVisible="{Binding IsCustomPresetSelected}">
                                    <PathIcon Data="{StaticResource IconTrash}" Width="13" Height="13" Foreground="{DynamicResource TextSecondary}"/>
                                </Button>

                                <Button Grid.Column="3" 
                                        Command="{Binding ImportEqualizerPresetCommand}" 
                                        Height="32" 
                                        Width="32" 
                                        Margin="6,0,0,0" 
                                        Classes="SystemButton"
                                        ToolTip.Tip="Импортировать пресет (.json)">
                                    <PathIcon Data="{StaticResource IconImport}" Width="13" Height="13" Foreground="{DynamicResource AccentBlue}"/>
                                </Button>

                                <Button Grid.Column="4" 
                                        Command="{Binding ExportEqualizerPresetCommand}" 
                                        Height="32" 
                                        Width="32" 
                                        Margin="6,0,0,0" 
                                        Classes="SystemButton"
                                        ToolTip.Tip="Экспортировать выбранный пресет (.json)">
                                    <PathIcon Data="{StaticResource IconExport}" Width="13" Height="13" Foreground="{DynamicResource AccentBlue}"/>
                                </Button>
                            </Grid>
                            
                            <Grid ColumnDefinitions="*, Auto" Margin="0,4,0,0">
                                <TextBox PlaceholderText="Имя нового пресета..." 
                                         Text="{Binding NewPresetName}" 
                                         Height="32" 
                                         CornerRadius="6"
                                         VerticalAlignment="Center"/>
                                <Button Grid.Column="1" 
                                        Command="{Binding SaveCurrentAsPresetCommand}" 
                                        Content="Сохранить" 
                                        Height="32" 
                                        Margin="6,0,0,0" 
                                        Classes="SystemButton"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Right Column: Settings & Equalizer Sliders -->
                <Border Classes="GlassCard eq-card-right" Padding="16" ClipToBounds="True">
                    <StackPanel Spacing="16">
                        <!-- Header: Title on Left, Toggle on Right -->
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource IconSettings}" Width="15" Height="15" Foreground="{DynamicResource AccentBlue}"/>
                                <TextBlock Text="Эквалайзер" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="EqToggle" IsChecked="{Binding IsEqualizerEnabled}" Foreground="{DynamicResource AccentBlue}" OnContent="" OffContent="" Padding="0" MinWidth="0" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <!-- Wrapper for collapsing right controls -->
                        <StackPanel Classes="eq-controls-right" Classes.hidden="{Binding !IsEqualizerEnabled}" Spacing="16" ClipToBounds="True">
                            <Separator Background="{DynamicResource BorderGray}" Margin="0,-8"/>

                            <!-- Audio Device Selector -->
                            <StackPanel Spacing="6" Margin="0,4,0,4">
                                <TextBlock Text="Устройство вывода:" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                <ComboBox ItemsSource="{Binding AudioDevices}" 
                                          SelectedItem="{Binding SelectedAudioDevice}" 
                                          HorizontalAlignment="Stretch" 
                                          CornerRadius="6"
                                          Height="32">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="vm:AudioDeviceItem">
                                            <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <!-- Echo warning tip -->
                            <Border Background="#150A84FF" BorderBrush="#300A84FF" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,-4,0,-4">
                                <Grid ColumnDefinitions="Auto, *">
                                    <PathIcon Grid.Column="0" Data="{StaticResource IconTip}" Width="14" Height="14" Foreground="{DynamicResource AccentBlue}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Если слышно эхо/дублирование: в Windows откройте свойства записи 'CABLE Output' -> вкладка 'Прослушивать' -> снимите флажок 'Прослушивать с данного устройства'." Foreground="{DynamicResource TextSecondary}" FontSize="10.5" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Separator Background="{DynamicResource BorderGray}"/>

                            <!-- Equalizer Sliders Row -->
                            <Grid ColumnDefinitions="Auto, 12, *" Height="185">
                                <!-- Left Column: Master Level Slider ("уровень") -->
                                <StackPanel Grid.Column="0" Spacing="0" HorizontalAlignment="Center" Width="80">
                                    <Grid ColumnDefinitions="*, Auto" Height="150" VerticalAlignment="Top">
                                        <!-- Master level vertical slider -->
                                        <Slider Grid.Column="0" 
                                                Orientation="Vertical" 
                                                Value="{Binding MasterEqGain}" 
                                                Minimum="-12" 
                                                Maximum="12" 
                                                Height="140" 
                                                Classes="EqSlider"
                                                VerticalAlignment="Center"/>
                                        <!-- dB Labels -->
                                        <Grid Grid.Column="1" RowDefinitions="*, *, *" Height="140" Margin="4,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Grid.Row="0" Text="12dB" FontSize="8.5" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Top"/>
                                            <TextBlock Grid.Row="1" Text="0dB" FontSize="8.5" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="2" Text="-12dB" FontSize="8.5" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Bottom"/>
                                        </Grid>
                                    </Grid>
                                    <TextBlock Text="уровень" FontSize="11" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>

                                <!-- Vertical Divider -->
                                <Border Grid.Column="1" Width="1.5" Background="#444444" Margin="4,5,4,20" VerticalAlignment="Stretch"/>

                                <!-- Right Column: 10 frequency sliders -->
                                <Grid Grid.Column="2" ColumnDefinitions="*, *, *, *, *, *, *, *, *, *">
                                    <!-- 60 Hz -->
                                    <StackPanel Grid.Column="0" Spacing="0" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                        <Slider Orientation="Vertical" Value="{Binding Eq60Hz}" Minimum="-12" Maximum="12" Height="140" Classes="EqSlider"/>
                                        <TextBlock Text="60" FontSize="10" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <!-- 170 Hz -->
                                    <StackPanel Grid.Column="1" Spacing="0" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                        <Slider Orientation="Vertical" Value="{Binding Eq170Hz}" Minimum="-12" Maximum="12" Height="140" Classes="EqSlider"/>
                                        <TextBlock Text="170" FontSize="10" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <!-- 310 Hz -->
                                    <StackPanel Grid.Column="2" Spacing="0" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                        <Slider Orientation="Vertical" Value="{Binding Eq310Hz}" Minimum="-12" Maximum="12" Height="140" Classes="EqSlider"/>
                                        <TextBlock Text="310" FontSize="10" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <!-- 600 Hz -->
                                    <StackPanel Grid.Column="3" Spacing="0" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                        <Slider Orientation="Vertical" Value="{Binding Eq600Hz}" Minimum="-12" Maximum="12" Height="140" Classes="EqSlider"/>
                                        <TextBlock Text="600" FontSize="10" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <!-- 1 kHz -->
                                    <StackPanel Grid.Column="4" Spacing="0" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                        <Slider Orientation="Vertical" Value="{Binding Eq1kHz}" Minimum="-12" Maximum="12" Height="140" Classes="EqSlider"/>
                                        <TextBlock Text="1k" FontSize="10" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <!-- 3 kHz -->
                                    <StackPanel Grid.Column="5" Spacing="0" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                        <Slider Orientation="Vertical" Value="{Binding Eq3kHz}" Minimum="-12" Maximum="12" Height="140" Classes="EqSlider"/>
                                        <TextBlock Text="3k" FontSize="10" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <!-- 6 kHz -->
                                    <StackPanel Grid.Column="6" Spacing="0" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                        <Slider Orientation="Vertical" Value="{Binding Eq6kHz}" Minimum="-12" Maximum="12" Height="140" Classes="EqSlider"/>
                                        <TextBlock Text="6k" FontSize="10" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <!-- 12 kHz -->
                                    <StackPanel Grid.Column="7" Spacing="0" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                        <Slider Orientation="Vertical" Value="{Binding Eq12kHz}" Minimum="-12" Maximum="12" Height="140" Classes="EqSlider"/>
                                        <TextBlock Text="12k" FontSize="10" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <!-- 14 kHz -->
                                    <StackPanel Grid.Column="8" Spacing="0" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                        <Slider Orientation="Vertical" Value="{Binding Eq14kHz}" Minimum="-12" Maximum="12" Height="140" Classes="EqSlider"/>
                                        <TextBlock Text="14k" FontSize="10" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <!-- 16 kHz -->
                                    <StackPanel Grid.Column="9" Spacing="0" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                        <Slider Orientation="Vertical" Value="{Binding Eq16kHz}" Minimum="-12" Maximum="12" Height="140" Classes="EqSlider"/>
                                        <TextBlock Text="16k" FontSize="10" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
