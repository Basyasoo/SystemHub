<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MacStyleHub.ViewModels"
        xmlns:services="using:MacStyleHub.Services"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1050" d:DesignHeight="680"
        Width="1050" Height="680"
        x:Class="MacStyleHub.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/app.ico"
        Title="SystemHub"
        WindowDecorations="None"
        WindowStartupLocation="CenterScreen"
        TransparencyLevelHint="Mica,AcrylicBlur"
        Background="Transparent">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <!-- Main Window Border with Rounded Corners -->
    <Border CornerRadius="10" ClipToBounds="True" Background="{DynamicResource MainBg}" BorderBrush="{DynamicResource BorderGray}" BorderThickness="1">
        <Grid ColumnDefinitions="230, 1, *">
            
            <!-- Left Sidebar (macOS style) -->
            <Grid Grid.Column="0" RowDefinitions="Auto, *, Auto" Background="{DynamicResource SidebarBg}">
                
                <!-- Custom Title Bar with traffic lights controls -->
                <Grid Grid.Row="0" Height="50" Background="Transparent" Name="TitleBar" PointerPressed="TitleBar_OnPointerPressed">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="20,0,0,0" VerticalAlignment="Center">
                        <!-- Red Button (Close) -->
                        <Button Width="12" Height="12" CornerRadius="6" Background="#FF5F56" BorderThickness="0" Padding="0" Click="Close_OnClick" ToolTip.Tip="{Binding ToolTipClose, Source={x:Static services:LocalizationService.Instance}}">
                            <Button.Styles>
                                <Style Selector="Button:pointerover">
                                    <Setter Property="Background" Value="#E04C40"/>
                                </Style>
                            </Button.Styles>
                        </Button>
                        <!-- Yellow Button (Minimize) -->
                        <Button Width="12" Height="12" CornerRadius="6" Background="#FFBD2E" BorderThickness="0" Padding="0" Click="Minimize_OnClick" ToolTip.Tip="{Binding ToolTipMinimize, Source={x:Static services:LocalizationService.Instance}}">
                            <Button.Styles>
                                <Style Selector="Button:pointerover">
                                    <Setter Property="Background" Value="#DE9E1B"/>
                                </Style>
                            </Button.Styles>
                        </Button>
                        <!-- Green Button (Maximize) -->
                        <Button Width="12" Height="12" CornerRadius="6" Background="#27C93F" BorderThickness="0" Padding="0" Click="Maximize_OnClick" ToolTip.Tip="{Binding ToolTipMaximize, Source={x:Static services:LocalizationService.Instance}}">
                            <Button.Styles>
                                <Style Selector="Button:pointerover">
                                    <Setter Property="Background" Value="#1FA330"/>
                                </Style>
                            </Button.Styles>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Sidebar Menu ListBox -->
                <ListBox Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="12,10,12,10"
                         SelectedIndex="{Binding SelectedMenuIndex}">
                    
                    <!-- Local styling for Sidebar items -->
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#8E8E93"/>
                            <Setter Property="CornerRadius" Value="6"/>
                            <Setter Property="Margin" Value="0,3"/>
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="Transitions">
                                <Transitions>
                                    <BrushTransition Property="Background" Duration="0:0:0.1"/>
                                    <BrushTransition Property="Foreground" Duration="0:0:0.1"/>
                                </Transitions>
                            </Setter>
                        </Style>
                        <Style Selector="ListBoxItem:pointerover">
                            <Setter Property="Background" Value="{DynamicResource SidebarHoverBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource SidebarHoverFg}"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected">
                            <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Style>
                    </ListBox.Styles>

                    <!-- Sidebar Menu Items (using vector icons) -->
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="{StaticResource IconHome}" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SidebarHome, Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="{StaticResource IconMoon}" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SidebarWeather, Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="{StaticResource IconSystem}" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SidebarSystem, Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="{StaticResource IconCleaner}" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SidebarCleaner, Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="{StaticResource IconSettings}" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SidebarStartup, Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="{StaticResource IconMusic}" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SidebarPlayer, Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="{StaticResource IconFlash}" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SidebarInstaller, Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="{StaticResource IconTip}" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SidebarAbout, Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>

                <!-- Now Playing Widget (Footer) -->
                <Border Grid.Row="2" Background="{DynamicResource SidebarBg}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderGray}" Padding="14,12" Height="68"
                        IsVisible="{Binding PlaybackVM.HasMedia}">
                    <Grid ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Center">
                        <!-- Playback indicator -->
                        <Border Grid.Column="0" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderGray}" BorderThickness="1" Width="32" Height="32" CornerRadius="4" Margin="0,0,10,0">
                            <PathIcon Data="{StaticResource IconMusic}" Width="14" Height="14" Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        
                        <!-- Song details -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding PlaybackVM.Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding PlaybackVM.Artist}" FontSize="10" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Play/Pause indicators wrapper as Button -->
                        <Button Grid.Column="2" Width="30" Height="30" Padding="0" CornerRadius="15" Background="Transparent" BorderThickness="0"
                                Command="{Binding PlaybackVM.TogglePlayCommand}" Margin="5,0,0,0">
                            <Grid>
                                <PathIcon Data="{StaticResource IconPause}" Width="12" Height="12" Foreground="{StaticResource AccentBlue}" IsVisible="{Binding PlaybackVM.IsPlaying}"/>
                                <PathIcon Data="{StaticResource IconPlay}" Width="12" Height="12" Foreground="{StaticResource TextSecondary}" IsVisible="{Binding !PlaybackVM.IsPlaying}"/>
                            </Grid>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- Sidebar Separator Line -->
            <Border Grid.Column="1" Width="1" Background="{DynamicResource BorderGray}" VerticalAlignment="Stretch"/>

            <!-- Right Main Content Panel -->
            <Grid Grid.Column="2" RowDefinitions="Auto, *" Background="{DynamicResource MainBg}">
                
                <!-- Titlebar extension for dragging main window area -->
                <Grid Grid.Row="0" Height="40" Background="Transparent" Name="RightTitleBar" PointerPressed="TitleBar_OnPointerPressed">
                    <TextBlock Text="SystemHub" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.9" LetterSpacing="-0.2"/>
                </Grid>
                
                <!-- Main Content Body with smooth page transitions and skeleton loading -->
                <Grid Grid.Row="1">
                    <!-- Main Content, visible when NOT loading -->
                    <TransitioningContentControl Content="{Binding CurrentPageViewModel}" ClipToBounds="True" IsVisible="{Binding !IsAppLoading}">
                        <TransitioningContentControl.PageTransition>
                            <CompositePageTransition>
                                <PageSlide Duration="0:0:0.35" Orientation="Horizontal">
                                    <PageSlide.SlideInEasing>
                                        <CubicEaseOut/>
                                    </PageSlide.SlideInEasing>
                                    <PageSlide.SlideOutEasing>
                                        <CubicEaseOut/>
                                    </PageSlide.SlideOutEasing>
                                </PageSlide>
                                <CrossFade Duration="0:0:0.25"/>
                            </CompositePageTransition>
                        </TransitioningContentControl.PageTransition>
                    </TransitioningContentControl>

                    <!-- Skeleton Loading View, visible when loading -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsAppLoading}">
                        <StackPanel Margin="30" Spacing="25">
                            <!-- Header Skeleton -->
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0" Spacing="8">
                                    <Border Classes="Skeleton" Width="220" Height="28" HorizontalAlignment="Left"/>
                                    <Border Classes="Skeleton" Width="140" Height="14" HorizontalAlignment="Left"/>
                                </StackPanel>
                                <Border Grid.Column="1" Classes="Skeleton" Width="120" Height="48" CornerRadius="6" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Row 1: Weather & Player Skeleton -->
                            <Grid ColumnDefinitions="*, *" RowDefinitions="Auto" HorizontalAlignment="Stretch">
                                <!-- Weather Card Skeleton -->
                                <Border Grid.Column="0" Classes="GlassCard" Margin="0,0,10,0" MinHeight="210" VerticalAlignment="Stretch">
                                    <Grid RowDefinitions="Auto, *, Auto">
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                                            <Border Classes="Skeleton" Width="100" Height="14" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                        <Grid Grid.Row="1" ColumnDefinitions="Auto, *" VerticalAlignment="Center" Margin="0,5">
                                            <!-- Circle Avatar (similar to the user's icon load) -->
                                            <Border Grid.Column="0" Classes="SkeletonCircle" Width="64" Height="64" Margin="0,0,20,0"/>
                                            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                                <Border Classes="Skeleton" Width="80" Height="24" HorizontalAlignment="Left"/>
                                                <Border Classes="Skeleton" Width="60" Height="14" HorizontalAlignment="Left"/>
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="25">
                                            <Border Classes="Skeleton" Width="60" Height="14"/>
                                            <Border Classes="Skeleton" Width="60" Height="14"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Player Card Skeleton -->
                                <Border Grid.Column="1" Classes="GlassCard" Margin="10,0,0,0" MinHeight="210" VerticalAlignment="Stretch">
                                    <Grid RowDefinitions="Auto, *">
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                                            <Border Classes="Skeleton" Width="120" Height="14" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                        <Grid Grid.Row="1" RowDefinitions="*, Auto" Margin="0,10,0,0">
                                            <StackPanel Grid.Row="0" Spacing="8" VerticalAlignment="Center">
                                                <Border Classes="Skeleton" Width="180" Height="18" HorizontalAlignment="Left"/>
                                                <Border Classes="Skeleton" Width="100" Height="14" HorizontalAlignment="Left"/>
                                            </StackPanel>
                                            <Grid Grid.Row="1" ColumnDefinitions="*, Auto" VerticalAlignment="Center" Margin="0,5,0,0">
                                                <Border Grid.Column="0" Classes="Skeleton" Width="60" Height="14" HorizontalAlignment="Left"/>
                                                <Border Grid.Column="1" Classes="Skeleton" Width="120" Height="14" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Row 2: Resources Card Skeleton -->
                            <Border Classes="SystemCard" HorizontalAlignment="Stretch" MinHeight="180">
                                <Grid RowDefinitions="Auto, *">
                                    <Border Grid.Row="0" Classes="Skeleton" Width="140" Height="16" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                                    <Grid Grid.Row="1" ColumnDefinitions="*, *" VerticalAlignment="Center">
                                        <!-- CPU Circle Outline -->
                                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                            <Grid Width="100" Height="100">
                                                <!-- Outline circle -->
                                                <Ellipse Width="90" Height="90" Stroke="{DynamicResource BorderGray}" StrokeThickness="8"/>
                                                <!-- Pulsing inner circle -->
                                                <Border Classes="SkeletonCircle" Width="64" Height="64"/>
                                            </Grid>
                                        </StackPanel>
                                        <!-- RAM Circle Outline -->
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                            <Grid Width="100" Height="100">
                                                <Ellipse Width="90" Height="90" Stroke="{DynamicResource BorderGray}" StrokeThickness="8"/>
                                                <Border Classes="SkeletonCircle" Width="64" Height="64"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Row 3: Tip Skeleton -->
                            <Border Classes="GlassCard" HorizontalAlignment="Stretch">
                                <Grid ColumnDefinitions="Auto, *">
                                    <Border Grid.Column="0" Classes="SkeletonCircle" Width="20" Height="20" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                                        <Border Classes="Skeleton" Width="120" Height="14" HorizontalAlignment="Left"/>
                                        <Border Classes="Skeleton" Width="400" Height="12" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Row 4: Settings Skeleton -->
                            <Border Classes="GlassCard" HorizontalAlignment="Stretch" Padding="20">
                                <StackPanel Spacing="15">
                                    <Border Classes="Skeleton" Width="150" Height="14" HorizontalAlignment="Left"/>
                                    <Grid ColumnDefinitions="*, *">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <Border Classes="Skeleton" Width="60" Height="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <Border Classes="Skeleton" Width="160" Height="24" CornerRadius="12"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Border Classes="Skeleton" Width="60" Height="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <Border Classes="Skeleton" Width="120" Height="24" CornerRadius="12"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
